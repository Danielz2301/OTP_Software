<Window x:Class="OTPSoftware.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource Window_Title}"
        Height="860" Width="1320" MinHeight="660" MinWidth="1020"
        WindowStartupLocation="CenterScreen"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Ideal"
        TextOptions.TextRenderingMode="ClearType"
        Background="{StaticResource BgPrimaryBrush}"
        Foreground="{StaticResource TextPrimaryBrush}"
        FontFamily="Segoe UI Variable Display, Segoe UI, Microsoft YaHei UI"
        FontSize="13">

    <Window.Resources>
        <!-- Compact language selector pill button style -->
        <Style x:Key="LangSwitchButtonStyle" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
        </Style>

        <!-- Shared RowStyle highlighting consecutive-NG alarm PMNT fixtures -->
        <Style x:Key="PmntAlarmDataGridRowStyle" TargetType="DataGridRow" BasedOn="{StaticResource {x:Type DataGridRow}}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsAlarm}" Value="True">
                    <Setter Property="Background" Value="{StaticResource AlarmRowBgBrush}"/>
                    <Setter Property="BorderBrush" Value="{StaticResource FailBrush}"/>
                    <Setter Property="BorderThickness" Value="3,0,0,0"/>
                </DataTrigger>
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding IsAlarm}" Value="True"/>
                        <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource Self}}" Value="True"/>
                    </MultiDataTrigger.Conditions>
                    <Setter Property="Background" Value="{StaticResource AlarmRowHoverBgBrush}"/>
                </MultiDataTrigger>
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding IsAlarm}" Value="True"/>
                        <Condition Binding="{Binding IsSelected, RelativeSource={RelativeSource Self}}" Value="True"/>
                    </MultiDataTrigger.Conditions>
                    <Setter Property="Background" Value="{StaticResource AlarmRowSelectedBgBrush}"/>
                </MultiDataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Shared base style for GPU-accelerated PMNT inline DataBars (ScaleTransform.ScaleX) -->
        <Style x:Key="GpuDataBarTrackStyle" TargetType="Border">
            <Setter Property="CornerRadius" Value="3"/>
            <Setter Property="RenderTransformOrigin" Value="0,0.5"/>
            <Setter Property="IsHitTestVisible" Value="False"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
        </Style>
    </Window.Resources>

    <Grid>
        <!-- Global State 4 Loading Indicator (top 2px indeterminate bar when IsBusy=True) -->
        <ProgressBar IsIndeterminate="True"
                     Height="2"
                     VerticalAlignment="Top"
                     HorizontalAlignment="Stretch"
                     Background="Transparent"
                     Foreground="{StaticResource AccentCyanBrush}"
                     IsHitTestVisible="False"
                     Panel.ZIndex="20">
            <ProgressBar.Style>
                <Style TargetType="ProgressBar" BasedOn="{StaticResource {x:Type ProgressBar}}">
                    <Setter Property="Visibility" Value="Collapsed"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsBusy}" Value="True">
                            <Setter Property="Visibility" Value="Visible"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </ProgressBar.Style>
        </ProgressBar>

        <!-- ================================================================ -->
        <!-- DESKTOP INDUSTRIAL DASHBOARD WORKSPACE                           -->
        <!-- ================================================================ -->
        <Grid Margin="16,12">
            <Grid.RowDefinitions>
                <!-- 0: Header & Machine Log Configuration Card -->
                <RowDefinition Height="Auto"/>
                <!-- 1: 5 KPI Metric Cards -->
                <RowDefinition Height="Auto"/>
                <!-- 2: Real-time Alert Banner -->
                <RowDefinition Height="Auto"/>
                <!-- 3: 3-Zone Command Bar (Filters | Status | Actions) -->
                <RowDefinition Height="Auto"/>
                <!-- 4: Main Tab Workspace (Log Records / PMNT Stats / Trend Chart) -->
                <RowDefinition Height="*"/>
                <!-- 5: Footer Status & Camera Health Bar -->
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- ROW 0: Header & Machine Configuration Card (collapsed in Kiosk mode) -->
            <Grid Grid.Row="0" x:Name="grdHeaderRow" Margin="0,0,0,12">
                <Grid.Style>
                    <Style TargetType="Grid">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsKioskMode}" Value="True">
                                <Setter Property="Visibility" Value="Collapsed"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>

                <Border Background="{StaticResource SurfaceCardBrush}"
                        BorderBrush="{StaticResource BorderHairlineBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="16,12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- Brand Lockup -->
                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,16,0">
                            <Border Background="{StaticResource HeaderBrandGradientBrush}"
                                    BorderBrush="{StaticResource AccentBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="8"
                                    Width="40" Height="40"
                                    Margin="0,0,12,0">
                                <Path Data="{StaticResource IconLightningGeometry}"
                                      Width="20" Height="20" Stretch="Uniform"
                                      Fill="{StaticResource BrandIconFgBrush}"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="{DynamicResource Header_AppTitle}"
                                               FontSize="16"
                                               FontWeight="Bold"
                                               Foreground="{StaticResource TextPrimaryBrush}"/>
                                    <Border Background="{StaticResource AccentTintBrush}"
                                            BorderBrush="{StaticResource AccentBorderBrush}"
                                            BorderThickness="1"
                                            CornerRadius="4"
                                            Padding="8,2"
                                            Margin="8,0,0,0"
                                            VerticalAlignment="Center">
                                        <TextBlock Text="{DynamicResource Header_LiveBadge}"
                                                   FontSize="11"
                                                   FontWeight="Bold"
                                                   Foreground="{StaticResource AccentCyanBrush}"/>
                                    </Border>
                                </StackPanel>
                                <TextBlock x:Name="lblAppSubtitle"
                                           Text="{Binding AppSubtitle}"
                                           FontSize="11"
                                           Foreground="{StaticResource TextSecondaryBrush}"
                                           Margin="0,4,0,0"/>
                            </StackPanel>
                        </StackPanel>

                        <!-- Dynamic Machine File Pickers (N Machines from Settings) -->
                        <ScrollViewer Grid.Column="1"
                                      VerticalAlignment="Center"
                                      Margin="4,0,12,0"
                                      MaxHeight="104"
                                      VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled">
                            <ItemsControl x:Name="icMachines"
                                          ItemsSource="{Binding MachineRows}"
                                          IsEnabled="{Binding IsNotRealtimeActive}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border CornerRadius="6"
                                                Padding="8,4"
                                                Margin="0,0,0,4"
                                                BorderThickness="1">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="{StaticResource SurfaceInputBrush}"/>
                                                    <Setter Property="BorderBrush" Value="{StaticResource BorderHairlineBrush}"/>
                                                    <Style.Triggers>
                                                        <!-- State 5: Highlight enabled machine row when OTP log path is empty -->
                                                        <MultiDataTrigger>
                                                            <MultiDataTrigger.Conditions>
                                                                <Condition Binding="{Binding Enabled}" Value="True"/>
                                                                <Condition Binding="{Binding LogPath}" Value=""/>
                                                            </MultiDataTrigger.Conditions>
                                                            <Setter Property="BorderBrush" Value="{StaticResource WarningBorderBrush}"/>
                                                            <Setter Property="Background" Value="{StaticResource WarningSubtleBgBrush}"/>
                                                        </MultiDataTrigger>
                                                        <MultiDataTrigger>
                                                            <MultiDataTrigger.Conditions>
                                                                <Condition Binding="{Binding Enabled}" Value="True"/>
                                                                <Condition Binding="{Binding LogPath}" Value="{x:Null}"/>
                                                            </MultiDataTrigger.Conditions>
                                                            <Setter Property="BorderBrush" Value="{StaticResource WarningBorderBrush}"/>
                                                            <Setter Property="Background" Value="{StaticResource WarningSubtleBgBrush}"/>
                                                        </MultiDataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <CheckBox Grid.Column="0"
                                                          IsChecked="{Binding Enabled}"
                                                          Tag="{Binding Name}"
                                                          VerticalAlignment="Center"
                                                          Margin="4,0,8,0"
                                                          ToolTip="{Binding EnableToolTip}"/>
                                                <Border Grid.Column="1"
                                                        Background="{Binding BgColor, Converter={StaticResource HexToFrozenBrushConverter}}"
                                                        BorderBrush="{Binding Color, Converter={StaticResource HexToFrozenBrushConverter}}"
                                                        BorderThickness="1"
                                                        CornerRadius="4"
                                                        Padding="8,2"
                                                        Margin="0,0,8,0"
                                                        VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Name}"
                                                               FontSize="11"
                                                               FontWeight="Bold"
                                                               Foreground="{Binding Color, Converter={StaticResource HexToFrozenBrushConverter}}"/>
                                                </Border>
                                                <TextBlock Grid.Column="2"
                                                           Text="{DynamicResource Header_OtpLabel}"
                                                           FontSize="11"
                                                           FontWeight="Bold"
                                                           Foreground="{StaticResource AccentBrush}"
                                                           VerticalAlignment="Center"
                                                           Margin="0,0,4,0"/>
                                                <TextBox Grid.Column="3"
                                                         Text="{Binding LogPath, UpdateSourceTrigger=LostFocus}"
                                                         Tag="OTP"
                                                         BorderThickness="0"
                                                         Background="Transparent"
                                                         Padding="4,4"
                                                         FontSize="13"
                                                         ToolTip="{Binding PathToolTip}"/>
                                                <Button Grid.Column="4"
                                                        Tag="OTP"
                                                        Style="{StaticResource SecondaryButtonStyle}"
                                                        Width="28" Height="28"
                                                        Padding="0"
                                                        Margin="4,0,0,0"
                                                        ToolTip="{DynamicResource Header_SelectOtpTooltip}"
                                                        Command="{Binding BrowseLogCommand}"
                                                        CommandParameter="OTP">
                                                    <Path Data="{StaticResource IconFolderGeometry}"
                                                          Width="14" Height="14" Stretch="Uniform"
                                                          Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                                          HorizontalAlignment="Center"
                                                          VerticalAlignment="Center"
                                                          IsHitTestVisible="False"/>
                                                </Button>
                                                <Border Grid.Column="5"
                                                        Width="1"
                                                        Background="{StaticResource BorderHairlineBrush}"
                                                        Margin="8,4"/>
                                                <TextBlock Grid.Column="6"
                                                           Text="{DynamicResource Header_MesLabel}"
                                                           FontSize="11"
                                                           FontWeight="Bold"
                                                           Foreground="{StaticResource AccentCyanBrush}"
                                                           VerticalAlignment="Center"
                                                           Margin="0,0,4,0"/>
                                                <TextBox Grid.Column="7"
                                                         Text="{Binding MesLogPath, UpdateSourceTrigger=LostFocus}"
                                                         Tag="MES"
                                                         BorderThickness="0"
                                                         Background="Transparent"
                                                         Padding="4,4"
                                                         FontSize="13"
                                                         ToolTip="{Binding MesPathToolTip}"/>
                                                <Button Grid.Column="8"
                                                        Tag="MES"
                                                        Style="{StaticResource AccentOutlineButtonStyle}"
                                                        Width="28" Height="28"
                                                        Padding="0"
                                                        Margin="4,0,0,0"
                                                        ToolTip="{DynamicResource Header_SelectMesTooltip}"
                                                        Command="{Binding BrowseLogCommand}"
                                                        CommandParameter="MES">
                                                    <Path Data="{StaticResource IconFolderGeometry}"
                                                          Width="14" Height="14" Stretch="Uniform"
                                                          Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                                          HorizontalAlignment="Center"
                                                          VerticalAlignment="Center"
                                                          IsHitTestVisible="False"/>
                                                </Button>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>

                        <!-- Language Switcher [ 🌐 EN | 中文 | VI ] + Primary Action: Load Log -->
                        <StackPanel Grid.Column="2" VerticalAlignment="Center">
                            <Border Background="{StaticResource SurfaceInputBrush}"
                                    BorderBrush="{StaticResource BorderHairlineBrush}"
                                    BorderThickness="1"
                                    CornerRadius="6"
                                    Padding="4"
                                    Margin="0,0,0,8"
                                    HorizontalAlignment="Right"
                                    ToolTip="{DynamicResource Header_LangTooltip}">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Path Data="{StaticResource IconGlobeGeometry}"
                                          Style="{StaticResource VectorIconPathStyle}"
                                          Width="14" Height="14"
                                          Fill="{StaticResource AccentCyanBrush}"
                                          Margin="4,0,4,0"/>
                                    <Button x:Name="btnLangEn"
                                            Content="EN"
                                            Command="{Binding SetLanguageCommand}"
                                            CommandParameter="en">
                                        <Button.Style>
                                            <Style TargetType="Button" BasedOn="{StaticResource LangSwitchButtonStyle}">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsLanguageEn}" Value="True">
                                                        <Setter Property="Background" Value="{StaticResource AccentTintBrush}"/>
                                                        <Setter Property="BorderBrush" Value="{StaticResource AccentBorderBrush}"/>
                                                        <Setter Property="Foreground" Value="{StaticResource AccentCyanBrush}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                    </Button>
                                    <Border Width="1" Height="12" Background="{StaticResource BorderHairlineBrush}" Margin="4,0"/>
                                    <Button x:Name="btnLangZh"
                                            Content="中文"
                                            Command="{Binding SetLanguageCommand}"
                                            CommandParameter="zh">
                                        <Button.Style>
                                            <Style TargetType="Button" BasedOn="{StaticResource LangSwitchButtonStyle}">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsLanguageZh}" Value="True">
                                                        <Setter Property="Background" Value="{StaticResource AccentTintBrush}"/>
                                                        <Setter Property="BorderBrush" Value="{StaticResource AccentBorderBrush}"/>
                                                        <Setter Property="Foreground" Value="{StaticResource AccentCyanBrush}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                    </Button>
                                    <Border Width="1" Height="12" Background="{StaticResource BorderHairlineBrush}" Margin="4,0"/>
                                    <Button x:Name="btnLangVi"
                                            Content="VI"
                                            Command="{Binding SetLanguageCommand}"
                                            CommandParameter="vi">
                                        <Button.Style>
                                            <Style TargetType="Button" BasedOn="{StaticResource LangSwitchButtonStyle}">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsLanguageVi}" Value="True">
                                                        <Setter Property="Background" Value="{StaticResource AccentTintBrush}"/>
                                                        <Setter Property="BorderBrush" Value="{StaticResource AccentBorderBrush}"/>
                                                        <Setter Property="Foreground" Value="{StaticResource AccentCyanBrush}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                    </Button>
                                </StackPanel>
                            </Border>

                            <Button x:Name="btnLoadLog"
                                    Style="{StaticResource PrimaryButtonStyle}"
                                    MinWidth="136"
                                    MinHeight="40"
                                    Padding="16,8"
                                    HorizontalAlignment="Stretch"
                                    FontSize="13"
                                    FontWeight="Bold"
                                    ToolTip="{DynamicResource Header_ReadLogTooltip}"
                                    Command="{Binding LoadLogCommand}">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False">
                                    <Grid Width="16" Height="16" VerticalAlignment="Center" Margin="0,0,8,0">
                                        <!-- Idle Icon -->
                                        <Path Data="{StaticResource IconLoadLogGeometry}"
                                              Width="16" Height="16" Stretch="Uniform"
                                              Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}">
                                            <Path.Style>
                                                <Style TargetType="Path">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsBusy}" Value="True">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Path.Style>
                                        </Path>
                                        <!-- State 4 Loading Spinner -->
                                        <Path Data="{StaticResource IconRefreshGeometry}"
                                              Width="16" Height="16" Stretch="Uniform"
                                              Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                              RenderTransformOrigin="0.5,0.5">
                                            <Path.RenderTransform>
                                                <RotateTransform Angle="0"/>
                                            </Path.RenderTransform>
                                            <Path.Style>
                                                <Style TargetType="Path">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsBusy}" Value="True">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                            <DataTrigger.EnterActions>
                                                                <BeginStoryboard x:Name="LoadSpinStoryboard">
                                                                    <Storyboard RepeatBehavior="Forever">
                                                                        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)"
                                                                                         From="0" To="360" Duration="0:0:0.9"/>
                                                                    </Storyboard>
                                                                </BeginStoryboard>
                                                            </DataTrigger.EnterActions>
                                                            <DataTrigger.ExitActions>
                                                                <StopStoryboard BeginStoryboardName="LoadSpinStoryboard"/>
                                                            </DataTrigger.ExitActions>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Path.Style>
                                        </Path>
                                    </Grid>
                                    <TextBlock Text="{DynamicResource Header_ReadLogBtn}" FontWeight="Bold" FontSize="13" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>

            <!-- ROW 1: 5 KPI Summary Cards (Tabular Numerals & Left Semantic Accent Bars) -->
            <Grid Grid.Row="1" Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1*"/>
                    <ColumnDefinition Width="1*"/>
                    <ColumnDefinition Width="1*"/>
                    <ColumnDefinition Width="1.15*"/>
                    <ColumnDefinition Width="1.85*"/>
                </Grid.ColumnDefinitions>

                <!-- Metric Card 1: TOTAL UNITS -->
                <Border Grid.Column="0"
                        Background="{StaticResource SurfaceCardBrush}"
                        BorderBrush="{StaticResource BorderHairlineBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Margin="0,0,8,0"
                        ClipToBounds="True">
                    <Grid>
                        <Border Width="3" HorizontalAlignment="Left" Background="{StaticResource AccentBrush}"/>
                        <StackPanel Margin="16,12,12,12">
                            <DockPanel>
                                <TextBlock Text="{DynamicResource Kpi_TotalUnits}"
                                           FontSize="11"
                                           FontWeight="Bold"
                                           VerticalAlignment="Center"
                                           Foreground="{StaticResource TextSecondaryBrush}"/>
                                <Border Background="{StaticResource AccentTintBrush}"
                                        CornerRadius="4"
                                        Padding="8,2"
                                        HorizontalAlignment="Right">
                                    <TextBlock Text="{DynamicResource Kpi_Scope}"
                                               FontSize="11"
                                               FontWeight="Bold"
                                               Foreground="{StaticResource AccentCyanBrush}"/>
                                </Border>
                            </DockPanel>
                            <TextBlock x:Name="lblTotalItems"
                                       Text="{Binding TotalItemsText}"
                                       Style="{StaticResource TabularTextStyle}"
                                       FontSize="24"
                                       FontWeight="Bold"
                                       Foreground="{StaticResource TextPrimaryBrush}"
                                       Margin="0,4,0,4"/>
                            <TextBlock Text="{Binding ShiftTargetText}"
                                       Style="{StaticResource TabularTextStyle}"
                                       FontSize="11"
                                       Foreground="{StaticResource TextMutedBrush}"
                                       TextTrimming="CharacterEllipsis"/>
                            <ProgressBar Minimum="0" Maximum="100"
                                         Value="{Binding ShiftProgressPercent, Mode=OneWay}"
                                         Height="4"
                                         Background="{StaticResource SurfaceInputBrush}"
                                         Foreground="{StaticResource AccentBrush}"
                                         Margin="0,8,0,0"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Metric Card 2: PASS (OK) -->
                <Border Grid.Column="1"
                        Background="{StaticResource SurfaceCardBrush}"
                        BorderBrush="{StaticResource BorderHairlineBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Margin="0,0,8,0"
                        ClipToBounds="True">
                    <Grid>
                        <Border Width="3" HorizontalAlignment="Left" Background="{StaticResource PassBrush}"/>
                        <StackPanel Margin="16,12,12,12">
                            <DockPanel>
                                <TextBlock Text="{DynamicResource Kpi_PassOk}"
                                           FontSize="11"
                                           FontWeight="Bold"
                                           VerticalAlignment="Center"
                                           Foreground="{StaticResource PassTextBrush}"/>
                                <Border Background="{StaticResource PassTintBrush}"
                                        BorderBrush="{StaticResource PassBorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="4"
                                        Padding="8,2"
                                        HorizontalAlignment="Right">
                                    <TextBlock Text="{DynamicResource Kpi_OkBadge}"
                                               FontSize="11"
                                               FontWeight="Bold"
                                               Foreground="{StaticResource PassTextBrush}"/>
                                </Border>
                            </DockPanel>
                            <TextBlock x:Name="lblOkItems"
                                       Text="{Binding OkItemsText}"
                                       Style="{StaticResource TabularTextStyle}"
                                       FontSize="24"
                                       FontWeight="Bold"
                                       Foreground="{StaticResource PassTextBrush}"
                                       Margin="0,4,0,4"/>
                            <TextBlock Text="{DynamicResource Kpi_WithinSpec}"
                                       FontSize="11"
                                       Foreground="{StaticResource TextMutedBrush}"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Metric Card 3: FAIL (NG) -->
                <Border Grid.Column="2"
                        Background="{StaticResource SurfaceCardBrush}"
                        BorderBrush="{StaticResource BorderHairlineBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Margin="0,0,8,0"
                        ClipToBounds="True">
                    <Grid>
                        <Border Width="3" HorizontalAlignment="Left" Background="{StaticResource FailBrush}"/>
                        <StackPanel Margin="16,12,12,12">
                            <DockPanel>
                                <TextBlock Text="{DynamicResource Kpi_FailNg}"
                                           FontSize="11"
                                           FontWeight="Bold"
                                           VerticalAlignment="Center"
                                           Foreground="{StaticResource FailTextBrush}"/>
                                <Border Background="{StaticResource FailTintBrush}"
                                        BorderBrush="{StaticResource FailBorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="4"
                                        Padding="8,2"
                                        HorizontalAlignment="Right">
                                    <TextBlock Text="{DynamicResource Kpi_DefectBadge}"
                                               FontSize="11"
                                               FontWeight="Bold"
                                               Foreground="{StaticResource FailTextBrush}"/>
                                </Border>
                            </DockPanel>
                            <TextBlock x:Name="lblNgItems"
                                       Text="{Binding NgItemsText}"
                                       Style="{StaticResource TabularTextStyle}"
                                       FontSize="24"
                                       FontWeight="Bold"
                                       Foreground="{StaticResource FailTextBrush}"
                                       Margin="0,4,0,4"/>
                            <TextBlock Text="{DynamicResource Kpi_RejectedPanels}"
                                       FontSize="11"
                                       Foreground="{StaticResource TextMutedBrush}"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Metric Card 4: DEFECT RATE & FPY YIELD RATE -->
                <Border Grid.Column="3"
                        Background="{StaticResource SurfaceCardBrush}"
                        BorderBrush="{StaticResource BorderHairlineBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Margin="0,0,8,0"
                        ClipToBounds="True">
                    <Grid>
                        <Border Width="3" HorizontalAlignment="Left" Background="{StaticResource WarningBrush}"/>
                        <StackPanel Margin="16,12,12,12">
                            <DockPanel>
                                <TextBlock Text="{DynamicResource Kpi_DefectRate}"
                                           FontSize="11"
                                           FontWeight="Bold"
                                           VerticalAlignment="Center"
                                           Foreground="{StaticResource WarningTextBrush}"/>
                                <Border Background="{StaticResource PassTintBrush}"
                                        BorderBrush="{StaticResource PassBorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="4"
                                        Padding="8,2"
                                        HorizontalAlignment="Right">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{DynamicResource Kpi_FpyPrefix}"
                                                   FontSize="11"
                                                   FontWeight="Bold"
                                                   Foreground="{StaticResource PassTextBrush}"/>
                                        <TextBlock Text="{Binding FpyRateText}"
                                                   Style="{StaticResource TabularTextStyle}"
                                                   FontSize="11"
                                                   FontWeight="Bold"
                                                   Foreground="{StaticResource PassTextBrush}"/>
                                    </StackPanel>
                                </Border>
                            </DockPanel>
                            <TextBlock x:Name="lblNgRate"
                                       Text="{Binding NgRateText}"
                                       Style="{StaticResource TabularTextStyle}"
                                       FontSize="24"
                                       FontWeight="Bold"
                                       Foreground="{StaticResource WarningTextBrush}"
                                       Margin="0,4,0,4"/>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{DynamicResource Kpi_YieldStatusPrefix}"
                                           FontSize="11"
                                           Foreground="{StaticResource TextMutedBrush}"/>
                                <TextBlock Text="{Binding KpiAlertLevel}"
                                           FontSize="11"
                                           FontWeight="Bold"
                                           Foreground="{Binding KpiHeroRateFg, Converter={StaticResource HexToFrozenBrushConverter}}"/>
                            </StackPanel>
                            <ProgressBar Minimum="0" Maximum="100"
                                         Value="{Binding FpyRate, Mode=OneWay}"
                                         Height="4"
                                         Background="{StaticResource SurfaceInputBrush}"
                                         Foreground="{Binding KpiHeroRateFg, Converter={StaticResource HexToFrozenBrushConverter}}"
                                         Margin="0,8,0,0"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Metric Card 5: OTP DEFECT DETAILS -->
                <Border Grid.Column="4"
                        Background="{StaticResource SurfaceCardBrush}"
                        BorderBrush="{StaticResource BorderHairlineBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        ClipToBounds="True">
                    <Grid>
                        <Border Width="3" HorizontalAlignment="Left" Background="{StaticResource AccentCyanBrush}"/>
                        <Grid Margin="16,12,12,12">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <DockPanel Grid.Row="0" Margin="0,0,0,8">
                                <TextBlock Text="{DynamicResource Kpi_DefectDetails}"
                                           FontSize="11"
                                           FontWeight="Bold"
                                           Foreground="{StaticResource TextSecondaryBrush}"/>
                                <TextBlock Text="{DynamicResource Kpi_ByCategory}"
                                           FontSize="11"
                                           FontWeight="Bold"
                                           Foreground="{StaticResource TextMutedBrush}"
                                           HorizontalAlignment="Right"/>
                            </DockPanel>
                            <UniformGrid Grid.Row="1" Columns="4">
                                <Border Background="{StaticResource SurfaceInputBrush}"
                                        BorderBrush="{StaticResource BorderHairlineBrush}"
                                        BorderThickness="1"
                                        CornerRadius="6"
                                        Padding="8,4"
                                        Margin="0,0,8,0">
                                    <StackPanel>
                                        <TextBlock Text="XYLV"
                                                   FontSize="11"
                                                   FontWeight="Bold"
                                                   Foreground="{StaticResource TextSecondaryBrush}"/>
                                        <Grid Margin="0,4,0,4">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock x:Name="lblXylvCount"
                                                       Grid.Column="0"
                                                       Text="{Binding XylvCountText}"
                                                       Style="{StaticResource TabularTextStyle}"
                                                       FontSize="16"
                                                       FontWeight="Bold"
                                                       Foreground="{StaticResource FailTextBrush}"/>
                                            <TextBlock Grid.Column="1"
                                                       Text="{Binding XylvShareText}"
                                                       Style="{StaticResource TabularTextStyle}"
                                                       FontSize="11"
                                                       FontWeight="SemiBold"
                                                       Foreground="{StaticResource FailTextBrush}"
                                                       VerticalAlignment="Bottom"
                                                       Margin="4,0,0,0"/>
                                        </Grid>
                                        <Border Height="4" CornerRadius="2" Background="{StaticResource SurfaceElevatedBrush}" ClipToBounds="True">
                                            <Border CornerRadius="2" Background="{StaticResource FailBrush}" RenderTransformOrigin="0,0.5">
                                                <Border.RenderTransform>
                                                    <ScaleTransform ScaleX="{Binding XylvShareRatio}" ScaleY="1"/>
                                                </Border.RenderTransform>
                                            </Border>
                                        </Border>
                                    </StackPanel>
                                </Border>
                                <Border Background="{StaticResource SurfaceInputBrush}"
                                        BorderBrush="{StaticResource BorderHairlineBrush}"
                                        BorderThickness="1"
                                        CornerRadius="6"
                                        Padding="8,4"
                                        Margin="0,0,8,0">
                                    <StackPanel>
                                        <TextBlock Text="POWERON"
                                                   FontSize="11"
                                                   FontWeight="Bold"
                                                   Foreground="{StaticResource TextSecondaryBrush}"/>
                                        <Grid Margin="0,4,0,4">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock x:Name="lblPowerOnCount"
                                                       Grid.Column="0"
                                                       Text="{Binding PowerOnCountText}"
                                                       Style="{StaticResource TabularTextStyle}"
                                                       FontSize="16"
                                                       FontWeight="Bold"
                                                       Foreground="{StaticResource WarningTextBrush}"/>
                                            <TextBlock Grid.Column="1"
                                                       Text="{Binding PowerOnShareText}"
                                                       Style="{StaticResource TabularTextStyle}"
                                                       FontSize="11"
                                                       FontWeight="SemiBold"
                                                       Foreground="{StaticResource WarningTextBrush}"
                                                       VerticalAlignment="Bottom"
                                                       Margin="4,0,0,0"/>
                                        </Grid>
                                        <Border Height="4" CornerRadius="2" Background="{StaticResource SurfaceElevatedBrush}" ClipToBounds="True">
                                            <Border CornerRadius="2" Background="{StaticResource WarningTextBrush}" RenderTransformOrigin="0,0.5">
                                                <Border.RenderTransform>
                                                    <ScaleTransform ScaleX="{Binding PowerOnShareRatio}" ScaleY="1"/>
                                                </Border.RenderTransform>
                                            </Border>
                                        </Border>
                                    </StackPanel>
                                </Border>
                                <Border Background="{StaticResource SurfaceInputBrush}"
                                        BorderBrush="{StaticResource BorderHairlineBrush}"
                                        BorderThickness="1"
                                        CornerRadius="6"
                                        Padding="8,4"
                                        Margin="0,0,8,0">
                                    <StackPanel>
                                        <TextBlock Text="POWEROFF"
                                                   FontSize="11"
                                                   FontWeight="Bold"
                                                   Foreground="{StaticResource TextSecondaryBrush}"/>
                                        <Grid Margin="0,4,0,4">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock x:Name="lblPowerOffCount"
                                                       Grid.Column="0"
                                                       Text="{Binding PowerOffCountText}"
                                                       Style="{StaticResource TabularTextStyle}"
                                                       FontSize="16"
                                                       FontWeight="Bold"
                                                       Foreground="{StaticResource PowerOffAccentBrush}"/>
                                            <TextBlock Grid.Column="1"
                                                       Text="{Binding PowerOffShareText}"
                                                       Style="{StaticResource TabularTextStyle}"
                                                       FontSize="11"
                                                       FontWeight="SemiBold"
                                                       Foreground="{StaticResource PowerOffAccentBrush}"
                                                       VerticalAlignment="Bottom"
                                                       Margin="4,0,0,0"/>
                                        </Grid>
                                        <Border Height="4" CornerRadius="2" Background="{StaticResource SurfaceElevatedBrush}" ClipToBounds="True">
                                            <Border CornerRadius="2" Background="{StaticResource PowerOffAccentBrush}" RenderTransformOrigin="0,0.5">
                                                <Border.RenderTransform>
                                                    <ScaleTransform ScaleX="{Binding PowerOffShareRatio}" ScaleY="1"/>
                                                </Border.RenderTransform>
                                            </Border>
                                        </Border>
                                    </StackPanel>
                                </Border>
                                <Border Background="{StaticResource SurfaceInputBrush}"
                                        BorderBrush="{StaticResource BorderHairlineBrush}"
                                        BorderThickness="1"
                                        CornerRadius="6"
                                        Padding="8,4">
                                    <StackPanel>
                                        <TextBlock Text="FLICKER"
                                                   FontSize="11"
                                                   FontWeight="Bold"
                                                   Foreground="{StaticResource TextSecondaryBrush}"/>
                                        <Grid Margin="0,4,0,4">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock x:Name="lblFlickerCount"
                                                       Grid.Column="0"
                                                       Text="{Binding FlickerCountText}"
                                                       Style="{StaticResource TabularTextStyle}"
                                                       FontSize="16"
                                                       FontWeight="Bold"
                                                       Foreground="{StaticResource AccentCyanBrush}"/>
                                            <TextBlock Grid.Column="1"
                                                       Text="{Binding FlickerShareText}"
                                                       Style="{StaticResource TabularTextStyle}"
                                                       FontSize="11"
                                                       FontWeight="SemiBold"
                                                       Foreground="{StaticResource AccentCyanBrush}"
                                                       VerticalAlignment="Bottom"
                                                       Margin="4,0,0,0"/>
                                        </Grid>
                                        <Border Height="4" CornerRadius="2" Background="{StaticResource SurfaceElevatedBrush}" ClipToBounds="True">
                                            <Border CornerRadius="2" Background="{StaticResource AccentCyanBrush}" RenderTransformOrigin="0,0.5">
                                                <Border.RenderTransform>
                                                    <ScaleTransform ScaleX="{Binding FlickerShareRatio}" ScaleY="1"/>
                                                </Border.RenderTransform>
                                            </Border>
                                        </Border>
                                    </StackPanel>
                                </Border>
                            </UniformGrid>
                        </Grid>
                    </Grid>
                </Border>
            </Grid>

            <!-- ROW 2: Real-time Alert Banner (collapsed until IsAlertVisible) -->
            <Border Grid.Row="2"
                    x:Name="bdrAlert"
                    Background="{Binding AlertBackground, Converter={StaticResource HexToFrozenBrushConverter}}"
                    BorderBrush="{Binding AlertBorderBrush, Converter={StaticResource HexToFrozenBrushConverter}}"
                    BorderThickness="1.5"
                    CornerRadius="8"
                    Padding="16,8"
                    Margin="0,0,0,12">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsAlertVisible}" Value="True">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0"
                               x:Name="lblAlertTitle"
                               Text="{Binding AlertTitle}"
                               FontSize="13"
                               FontWeight="Bold"
                               Foreground="{Binding AlertTitleColor, Converter={StaticResource HexToFrozenBrushConverter}}"
                               Margin="0,0,12,0"
                               VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="1"
                               x:Name="txtAlertMessage"
                               Text="{Binding AlertMessage}"
                               Style="{StaticResource TabularTextStyle}"
                               Foreground="{StaticResource TextPrimaryBrush}"
                               FontSize="13"
                               VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis"/>
                    <Button Grid.Column="2"
                            x:Name="btnDismissAlert"
                            Style="{StaticResource DangerButtonStyle}"
                            Padding="12,4"
                            FontSize="11"
                            FontWeight="Bold"
                            Command="{Binding DismissAlertCommand}">
                        <StackPanel Orientation="Horizontal" IsHitTestVisible="False">
                            <Path Style="{StaticResource VectorIconPathStyle}"
                                  Data="{StaticResource IconCloseGeometry}"
                                  Width="12" Height="12"
                                  Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                  Margin="0,0,6,0"/>
                            <TextBlock Text="{DynamicResource Alert_DismissBtn}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </Grid>
            </Border>

            <!-- ROW 3: 2-Zone Command Bar (Left: Filters | Right: Actions) -->
            <Border Grid.Row="3"
                    x:Name="bdrFilterBar"
                    BorderBrush="{StaticResource BorderHairlineBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="12,8"
                    Margin="0,0,0,12">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Background" Value="{StaticResource SurfaceCardBrush}"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsKioskMode}" Value="True">
                                <Setter Property="Visibility" Value="Collapsed"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- ZONE 1 (LEFT): Search & Filter Controls -->
                    <WrapPanel Grid.Column="0" VerticalAlignment="Center">
                        <!-- Source Machine Filter -->
                        <StackPanel Orientation="Horizontal" Margin="0,4,12,4" VerticalAlignment="Center">
                            <TextBlock Text="{DynamicResource Filter_Machine}"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       FontSize="13"
                                       VerticalAlignment="Center"
                                       Margin="0,0,8,0"/>
                            <ComboBox x:Name="cmbSourceFilter"
                                      MinWidth="128"
                                      MinHeight="32"
                                      FontSize="13"
                                      ItemsSource="{Binding SourceFilterItems}"
                                      SelectedIndex="{Binding SelectedSourceIndex, Mode=TwoWay}"/>
                        </StackPanel>

                        <!-- Status Filter -->
                        <StackPanel Orientation="Horizontal" Margin="0,4,12,4" VerticalAlignment="Center">
                            <TextBlock Text="{DynamicResource Filter_Status}"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       FontSize="13"
                                       VerticalAlignment="Center"
                                       Margin="0,0,8,0"/>
                            <ComboBox x:Name="cmbStatusFilter"
                                      MinWidth="128"
                                      MinHeight="32"
                                      FontSize="13"
                                      SelectedIndex="{Binding SelectedStatusIndex, Mode=TwoWay}">
                                <ComboBoxItem Content="{DynamicResource Filter_StatusAll}"/>
                                <ComboBoxItem Content="{DynamicResource Filter_StatusNgOnly}"/>
                                <ComboBoxItem Content="{DynamicResource Filter_StatusOkOnly}"/>
                            </ComboBox>
                        </StackPanel>

                        <!-- Search PMNT -->
                        <StackPanel Orientation="Horizontal" Margin="0,4,12,4" VerticalAlignment="Center">
                            <TextBlock Text="{DynamicResource Filter_Pmnt}"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       FontSize="13"
                                       VerticalAlignment="Center"
                                       Margin="0,0,8,0"/>
                            <TextBox x:Name="txtSearchPMNT"
                                     Width="104"
                                     MinHeight="32"
                                     FontSize="13"
                                     Text="{Binding SearchPmnt, UpdateSourceTrigger=PropertyChanged}"
                                     ToolTip="{DynamicResource Filter_PmntTooltip}"/>
                        </StackPanel>

                        <!-- Search Panel -->
                        <StackPanel Orientation="Horizontal" Margin="0,4,12,4" VerticalAlignment="Center">
                            <TextBlock Text="{DynamicResource Filter_Panel}"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       FontSize="13"
                                       VerticalAlignment="Center"
                                       Margin="0,0,8,0"/>
                            <TextBox x:Name="txtSearchPanel"
                                     Width="116"
                                     MinHeight="32"
                                     FontSize="13"
                                     Text="{Binding SearchPanel, UpdateSourceTrigger=PropertyChanged}"
                                     ToolTip="{DynamicResource Filter_PanelTooltip}"/>
                        </StackPanel>

                        <!-- Start Date & Time -->
                        <StackPanel Orientation="Horizontal" Margin="0,4,12,4" VerticalAlignment="Center">
                            <TextBlock Text="{DynamicResource Filter_From}"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       FontSize="13"
                                       VerticalAlignment="Center"
                                       Margin="0,0,8,0"/>
                            <DatePicker x:Name="dpStartDate"
                                        Width="116"
                                        MinHeight="32"
                                        FontSize="13"
                                        SelectedDate="{Binding StartDate, Mode=TwoWay}"
                                        DisplayDate="{Binding DisplayStartDate, Mode=OneWay}"
                                        ToolTip="{DynamicResource Filter_FromDateTooltip}"/>
                            <ComboBox x:Name="cmbStartHour"
                                      Width="56"
                                      MinHeight="32"
                                      FontSize="13"
                                      Margin="4,0,0,0"
                                      ToolTip="{DynamicResource Filter_StartHourTooltip}"
                                      ItemsSource="{Binding Hours}"
                                      SelectedIndex="{Binding SelectedStartHourIndex, Mode=TwoWay}"/>
                            <TextBlock Text=":"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       FontSize="13"
                                       FontWeight="Bold"
                                       VerticalAlignment="Center"
                                       Margin="4,0"/>
                            <ComboBox x:Name="cmbStartMinute"
                                      Width="56"
                                      MinHeight="32"
                                      FontSize="13"
                                      ToolTip="{DynamicResource Filter_StartMinTooltip}"
                                      ItemsSource="{Binding Minutes}"
                                      SelectedIndex="{Binding SelectedStartMinuteIndex, Mode=TwoWay}"/>
                        </StackPanel>

                        <!-- End Date & Time -->
                        <StackPanel Orientation="Horizontal" Margin="0,4,12,4" VerticalAlignment="Center">
                            <TextBlock Text="{DynamicResource Filter_To}"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       FontSize="13"
                                       VerticalAlignment="Center"
                                       Margin="0,0,8,0"/>
                            <DatePicker x:Name="dpEndDate"
                                        Width="116"
                                        MinHeight="32"
                                        FontSize="13"
                                        SelectedDate="{Binding EndDate, Mode=TwoWay}"
                                        DisplayDate="{Binding DisplayEndDate, Mode=OneWay}"
                                        ToolTip="{DynamicResource Filter_ToDateTooltip}"/>
                            <ComboBox x:Name="cmbEndHour"
                                      Width="56"
                                      MinHeight="32"
                                      FontSize="13"
                                      Margin="4,0,0,0"
                                      ToolTip="{DynamicResource Filter_EndHourTooltip}"
                                      ItemsSource="{Binding Hours}"
                                      SelectedIndex="{Binding SelectedEndHourIndex, Mode=TwoWay}"/>
                            <TextBlock Text=":"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       FontSize="13"
                                       FontWeight="Bold"
                                       VerticalAlignment="Center"
                                       Margin="4,0"/>
                            <ComboBox x:Name="cmbEndMinute"
                                      Width="56"
                                      MinHeight="32"
                                      FontSize="13"
                                      ToolTip="{DynamicResource Filter_EndMinTooltip}"
                                      ItemsSource="{Binding Minutes}"
                                      SelectedIndex="{Binding SelectedEndMinuteIndex, Mode=TwoWay}"/>
                        </StackPanel>

                        <!-- Clear Filter -->
                        <Button x:Name="btnClearFilter"
                                Style="{StaticResource GhostButtonStyle}"
                                MinHeight="32"
                                Margin="0,4,4,4"
                                Padding="12,4"
                                FontSize="13"
                                ToolTip="{DynamicResource Filter_ClearTooltip}"
                                Command="{Binding ClearFilterCommand}">
                            <StackPanel Orientation="Horizontal" IsHitTestVisible="False">
                                <Path Data="{StaticResource IconFilterClearGeometry}"
                                      Width="14" Height="14" Stretch="Uniform"
                                      Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                      VerticalAlignment="Center"
                                      Margin="0,0,6,0"/>
                                <TextBlock Text="{DynamicResource Filter_ClearBtn}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </WrapPanel>

                    <!-- ZONE 2 (RIGHT): Action & Display Mode Buttons -->
                    <WrapPanel Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="12,0,0,0">
                        <Button x:Name="btnToggleRealtime"
                                Margin="0,4,8,4"
                                MinHeight="32"
                                Padding="12,4"
                                FontSize="13"
                                FontWeight="Bold"
                                Command="{Binding ToggleRealtimeCommand}">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                    <Setter Property="Background" Value="{StaticResource PassTintBrush}"/>
                                    <Setter Property="BorderBrush" Value="{StaticResource PassBorderBrush}"/>
                                    <Setter Property="Foreground" Value="{StaticResource PassTextBrush}"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsRealtimeActive}" Value="True">
                                            <Setter Property="Background" Value="{StaticResource FailTintBrush}"/>
                                            <Setter Property="BorderBrush" Value="{StaticResource FailBorderBrush}"/>
                                            <Setter Property="Foreground" Value="{StaticResource FailTextBrush}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                            <StackPanel Orientation="Horizontal" IsHitTestVisible="False">
                                <!-- Live pulsing indicator when realtime polling is active -->
                                <Ellipse Width="8" Height="8" Margin="0,0,8,0" VerticalAlignment="Center">
                                    <Ellipse.Style>
                                        <Style TargetType="Ellipse">
                                            <Setter Property="Fill" Value="{StaticResource PassBrush}"/>
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <MultiDataTrigger>
                                                    <MultiDataTrigger.Conditions>
                                                        <Condition Binding="{Binding IsRealtimeActive}" Value="True"/>
                                                        <Condition Binding="{Binding IsKioskMode}" Value="False"/>
                                                        <Condition Binding="{Binding IsVisible, RelativeSource={RelativeSource Self}}" Value="True"/>
                                                    </MultiDataTrigger.Conditions>
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                    <MultiDataTrigger.EnterActions>
                                                        <BeginStoryboard x:Name="RealtimeBtnDotPulseStoryboard">
                                                            <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                                                                <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                                                 From="1.0" To="0.3" Duration="0:0:0.85"/>
                                                            </Storyboard>
                                                        </BeginStoryboard>
                                                    </MultiDataTrigger.EnterActions>
                                                    <MultiDataTrigger.ExitActions>
                                                        <StopStoryboard BeginStoryboardName="RealtimeBtnDotPulseStoryboard"/>
                                                    </MultiDataTrigger.ExitActions>
                                                </MultiDataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Ellipse.Style>
                                </Ellipse>
                                <Path Width="14" Height="14" Stretch="Uniform"
                                      Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                      VerticalAlignment="Center"
                                      Margin="0,0,6,0">
                                    <Path.Style>
                                        <Style TargetType="Path">
                                            <Setter Property="Data" Value="{StaticResource IconPlayGeometry}"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsRealtimeActive}" Value="True">
                                                    <Setter Property="Data" Value="{StaticResource IconPauseGeometry}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Path.Style>
                                </Path>
                                <TextBlock Text="{Binding RealtimeButtonText}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <Button x:Name="btnExportCsv"
                                Style="{StaticResource SecondaryButtonStyle}"
                                MinHeight="32"
                                Margin="0,4,8,4"
                                Padding="12,4"
                                FontSize="13"
                                Command="{Binding ExportCsvCommand}">
                            <StackPanel Orientation="Horizontal" IsHitTestVisible="False">
                                <Path Data="{StaticResource IconExportGeometry}"
                                      Width="14" Height="14" Stretch="Uniform"
                                      Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                      VerticalAlignment="Center"
                                      Margin="0,0,6,0"/>
                                <TextBlock Text="{DynamicResource Filter_ExportCsvBtn}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <Button x:Name="btnExportShift"
                                Style="{StaticResource SecondaryButtonStyle}"
                                MinHeight="32"
                                Margin="0,4,8,4"
                                Padding="12,4"
                                FontSize="13"
                                Command="{Binding ExportShiftCommand}"
                                ToolTip="{DynamicResource Filter_ShiftReportTooltip}">
                            <StackPanel Orientation="Horizontal" IsHitTestVisible="False">
                                <Path Data="{StaticResource IconReportGeometry}"
                                      Width="14" Height="14" Stretch="Uniform"
                                      Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                      VerticalAlignment="Center"
                                      Margin="0,0,6,0"/>
                                <TextBlock Text="{DynamicResource Filter_ShiftReportBtn}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <Button x:Name="btnKioskMode"
                                Style="{StaticResource SecondaryButtonStyle}"
                                MinHeight="32"
                                Margin="0,4,0,4"
                                Padding="12,4"
                                FontSize="13"
                                Command="{Binding ToggleKioskCommand}"
                                ToolTip="{DynamicResource Filter_WallboardTooltip}">
                            <StackPanel Orientation="Horizontal" IsHitTestVisible="False">
                                <Path Data="{StaticResource IconMonitorGeometry}"
                                      Width="14" Height="14" Stretch="Uniform"
                                      Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                      VerticalAlignment="Center"
                                      Margin="0,0,6,0"/>
                                <TextBlock Text="{DynamicResource Filter_WallboardBtn}" VerticalAlignment="Center"/>
                                <Border Style="{StaticResource KbdBadgeBorderStyle}">
                                    <TextBlock Text="F11" Style="{StaticResource KbdBadgeTextStyle}" FontSize="11"/>
                                </Border>
                            </StackPanel>
                        </Button>
                    </WrapPanel>
                </Grid>
            </Border>

            <!-- ROW 4: Main Tab Workspace -->
            <TabControl Grid.Row="4"
                        x:Name="mainTabControl"
                        SelectedIndex="{Binding SelectedTabIndex, Mode=TwoWay}">

                <!-- TAB 0: Detailed Log List -->
                <TabItem>
                    <TabItem.Header>
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource IconListGeometry}"
                                  Width="13" Height="13" Stretch="Uniform"
                                  Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=TabItem}}"
                                  VerticalAlignment="Center"
                                  Margin="0,0,6,0"/>
                            <TextBlock Text="{DynamicResource Tab_LogRecords}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </TabItem.Header>
                    <Border Background="{StaticResource SurfaceCardBrush}"
                            BorderBrush="{StaticResource BorderHairlineBrush}"
                            BorderThickness="1"
                            CornerRadius="0,8,8,8"
                            Padding="16,12">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <!-- DataGrid Toolbar Options -->
                            <DockPanel Grid.Row="0" Margin="0,0,0,8">
                                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" VerticalAlignment="Center">
                                    <CheckBox x:Name="chkAutoScroll"
                                              Content="{DynamicResource Tab_AutoScroll}"
                                              IsChecked="{Binding AutoScroll, Mode=TwoWay}"
                                              FontSize="13"
                                              VerticalAlignment="Center"
                                              Margin="0,0,16,0"/>
                                    <CheckBox x:Name="chkSoundAlert"
                                              Content="{DynamicResource Tab_SoundAlert}"
                                              IsChecked="{Binding SoundAlert, Mode=TwoWay}"
                                              FontSize="13"
                                              VerticalAlignment="Center"/>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
                                        <Path Data="{StaticResource IconInfoGeometry}"
                                              Style="{StaticResource VectorIconPathStyle}"
                                              Width="14" Height="14"
                                              Fill="{StaticResource AccentCyanBrush}"
                                              Margin="0,0,6,0"/>
                                        <TextBlock Text="{DynamicResource Tab_GridHintPrefix}"
                                                   FontSize="11"
                                                   Foreground="{StaticResource TextMutedBrush}"
                                                   VerticalAlignment="Center"/>
                                        <Border Style="{StaticResource KbdBadgeBorderStyle}" Margin="6,0,6,0">
                                            <TextBlock Text="Ctrl+C" Style="{StaticResource KbdBadgeTextStyle}" FontSize="11"/>
                                        </Border>
                                        <TextBlock Text="{DynamicResource Tab_GridHintSuffix}"
                                                   FontSize="11"
                                                   Foreground="{StaticResource TextMutedBrush}"
                                                   VerticalAlignment="Center"/>
                                    </StackPanel>
                                </StackPanel>
                                <Border Background="{StaticResource SurfaceInputBrush}"
                                        BorderBrush="{StaticResource BorderHairlineBrush}"
                                        BorderThickness="1"
                                        CornerRadius="6"
                                        Padding="8,4"
                                        DockPanel.Dock="Right"
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Center">
                                    <TextBlock x:Name="lblFilteredCount"
                                               Text="{Binding FilteredCountText}"
                                               Style="{StaticResource TabularTextStyle}"
                                               FontSize="11"
                                               FontWeight="SemiBold"
                                               Foreground="{StaticResource AccentCyanBrush}"/>
                                </Border>
                            </DockPanel>

                            <!-- Flattened High-FPS Virtualized DataGrid + Loading/Empty Overlays -->
                            <Grid Grid.Row="1">
                                <DataGrid x:Name="dgResults"
                                          ItemsSource="{Binding DisplayList}"
                                          SelectedItem="{Binding SelectedResultItem, Mode=TwoWay}"
                                          RowHeight="32"
                                          EnableRowVirtualization="True"
                                          EnableColumnVirtualization="True"
                                          VirtualizingPanel.IsVirtualizing="True"
                                          VirtualizingPanel.VirtualizationMode="Recycling"
                                          VirtualizingPanel.ScrollUnit="Pixel"
                                          VirtualizingPanel.CacheLength="2,2"
                                          VirtualizingPanel.CacheLengthUnit="Page"
                                          ScrollViewer.IsDeferredScrollingEnabled="False">
                                    <DataGrid.ContextMenu>
                                        <ContextMenu x:Name="cmResults">
                                            <MenuItem x:Name="cmiCopyCell" Header="{Binding GridActions.CopyCellHeader}" IsEnabled="{Binding GridActions.IsCopyCellEnabled}" FontWeight="Bold" Command="{Binding CopyCellCommand}"/>
                                            <MenuItem x:Name="cmiCopyRow" Header="{Binding GridActions.CopyRowHeader}" Command="{Binding CopyRowCommand}"/>
                                            <MenuItem x:Name="cmiCopyRowWithHeader" Header="{Binding GridActions.CopyRowWithHeaderHeader}" Command="{Binding CopyRowWithHeaderCommand}"/>
                                            <Separator/>
                                            <MenuItem x:Name="cmiCopyPanel" Header="{Binding GridActions.CopyPanelHeader}" IsEnabled="{Binding GridActions.IsCopyPanelEnabled}" Command="{Binding CopyPanelCommand}"/>
                                            <MenuItem x:Name="cmiCopyBlu" Header="{Binding GridActions.CopyBluHeader}" IsEnabled="{Binding GridActions.IsCopyBluEnabled}" Command="{Binding CopyBluCommand}"/>
                                            <MenuItem x:Name="cmiCopyPMNT" Header="{Binding GridActions.CopyPmntHeader}" IsEnabled="{Binding GridActions.IsCopyPmntEnabled}" Command="{Binding CopyPmntCommand}"/>
                                            <Separator/>
                                            <MenuItem x:Name="cmiFilterPMNT" Header="{Binding GridActions.FilterPmntHeader}" IsEnabled="{Binding GridActions.IsFilterPmntEnabled}" Command="{Binding FilterCurrentPmntCommand}"/>
                                            <MenuItem x:Name="cmiFilterPanel" Header="{Binding GridActions.FilterPanelHeader}" IsEnabled="{Binding GridActions.IsFilterPanelEnabled}" Command="{Binding FilterCurrentPanelCommand}"/>
                                            <Separator/>
                                            <MenuItem x:Name="cmiOpenImagesBoth" Header="{Binding GridActions.OpenImagesBothHeader}" IsEnabled="{Binding GridActions.IsOpenImagesBothEnabled}" FontWeight="Bold" Command="{Binding OpenImagesBothCommand}"/>
                                            <MenuItem x:Name="cmiOpenImagesLeft" Header="{Binding GridActions.OpenImagesLeftHeader}" IsEnabled="{Binding GridActions.IsOpenImagesLeftEnabled}" Command="{Binding OpenImagesLeftCommand}"/>
                                            <MenuItem x:Name="cmiOpenImagesRight" Header="{Binding GridActions.OpenImagesRightHeader}" IsEnabled="{Binding GridActions.IsOpenImagesRightEnabled}" Command="{Binding OpenImagesRightCommand}"/>
                                        </ContextMenu>
                                    </DataGrid.ContextMenu>
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="#"
                                                            Binding="{Binding No}"
                                                            Width="56"
                                                            ElementStyle="{StaticResource TabularDataGridTextStyle}"/>
                                        <!-- Source Machine Column (Flattened: single Border + TextBlock) -->
                                        <DataGridTemplateColumn Width="96"
                                                                MinWidth="92"
                                                                ClipboardContentBinding="{Binding Source}">
                                            <DataGridTemplateColumn.Header>
                                                <TextBlock Text="{DynamicResource Col_Source}"
                                                           TextTrimming="CharacterEllipsis"
                                                           ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
                                            </DataGridTemplateColumn.Header>
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <Border CornerRadius="4"
                                                            Padding="8,2"
                                                            HorizontalAlignment="Left"
                                                            Background="{Binding SourceBg, Converter={StaticResource HexToFrozenBrushConverter}}"
                                                            BorderBrush="{Binding SourceFg, Converter={StaticResource HexToFrozenBrushConverter}}"
                                                            BorderThickness="1">
                                                        <TextBlock Text="{Binding Source}"
                                                                   Foreground="{Binding SourceFg, Converter={StaticResource HexToFrozenBrushConverter}}"
                                                                   FontWeight="Bold"
                                                                   FontSize="11"/>
                                                    </Border>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                        <DataGridTextColumn Binding="{Binding TimeFormatted}"
                                                            Width="148"
                                                            ElementStyle="{StaticResource TabularDataGridTextStyle}">
                                            <DataGridTextColumn.Header>
                                                <TextBlock Text="{DynamicResource Col_Timestamp}"
                                                           TextTrimming="CharacterEllipsis"
                                                           ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
                                            </DataGridTextColumn.Header>
                                        </DataGridTextColumn>
                                        <DataGridTextColumn Binding="{Binding PMNT}"
                                                            Width="112"
                                                            MinWidth="104"
                                                            ElementStyle="{StaticResource TabularDataGridTextStyle}">
                                            <DataGridTextColumn.Header>
                                                <TextBlock Text="{DynamicResource Col_PmntCode}"
                                                           TextTrimming="CharacterEllipsis"
                                                           ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
                                            </DataGridTextColumn.Header>
                                        </DataGridTextColumn>
                                        <DataGridTextColumn Binding="{Binding RunDisplay}"
                                                            Width="78"
                                                            ElementStyle="{StaticResource TabularDataGridTextStyle}">
                                            <DataGridTextColumn.Header>
                                                <TextBlock Text="{DynamicResource Col_Run}"
                                                           TextTrimming="CharacterEllipsis"
                                                           ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
                                            </DataGridTextColumn.Header>
                                        </DataGridTextColumn>
                                        <DataGridTextColumn Binding="{Binding PanelName}"
                                                            Width="1.2*"
                                                            MinWidth="130"
                                                            ElementStyle="{StaticResource TabularDataGridTextStyle}">
                                            <DataGridTextColumn.Header>
                                                <TextBlock Text="{DynamicResource Col_PanelName}"
                                                           TextTrimming="CharacterEllipsis"
                                                           ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
                                            </DataGridTextColumn.Header>
                                        </DataGridTextColumn>
                                        <DataGridTextColumn Binding="{Binding BluName}"
                                                            Width="1.5*"
                                                            MinWidth="150"
                                                            ElementStyle="{StaticResource DataGridCellTextStyle}">
                                            <DataGridTextColumn.Header>
                                                <TextBlock Text="{DynamicResource Col_BluName}"
                                                           TextTrimming="CharacterEllipsis"
                                                           ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
                                            </DataGridTextColumn.Header>
                                        </DataGridTextColumn>
                                        <!-- Status Pill Badge Column (15% translucent fill + WCAG AA text + 1px semantic border) -->
                                        <DataGridTemplateColumn Width="112"
                                                                ClipboardContentBinding="{Binding StatusText}">
                                            <DataGridTemplateColumn.Header>
                                                <TextBlock Text="{DynamicResource Col_Status}"
                                                           TextTrimming="CharacterEllipsis"
                                                           ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
                                            </DataGridTemplateColumn.Header>
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <Border CornerRadius="4"
                                                            Padding="8,2"
                                                            HorizontalAlignment="Left"
                                                            BorderThickness="1">
                                                        <Border.Style>
                                                            <Style TargetType="Border">
                                                                <Setter Property="Background" Value="{StaticResource PassTintBrush}"/>
                                                                <Setter Property="BorderBrush" Value="{StaticResource PassBorderBrush}"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsNG}" Value="True">
                                                                        <Setter Property="Background" Value="{StaticResource FailTintBrush}"/>
                                                                        <Setter Property="BorderBrush" Value="{StaticResource FailBorderBrush}"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Border.Style>
                                                        <TextBlock Text="{Binding StatusText}"
                                                                   FontWeight="Bold"
                                                                   FontSize="11">
                                                            <TextBlock.Style>
                                                                <Style TargetType="TextBlock">
                                                                    <Setter Property="Foreground" Value="{StaticResource PassTextBrush}"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding IsNG}" Value="True">
                                                                            <Setter Property="Foreground" Value="{StaticResource FailTextBrush}"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </TextBlock.Style>
                                                        </TextBlock>
                                                    </Border>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                        <!-- MES Detail Action Column -->
                                        <DataGridTemplateColumn Width="124">
                                            <DataGridTemplateColumn.Header>
                                                <TextBlock Text="{DynamicResource Col_MesDetails}"
                                                           TextTrimming="CharacterEllipsis"
                                                           ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
                                            </DataGridTemplateColumn.Header>
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <Button Style="{StaticResource AccentOutlineButtonStyle}"
                                                            Padding="8,2"
                                                            FontSize="11"
                                                            HorizontalAlignment="Left"
                                                            VerticalAlignment="Center"
                                                            ToolTip="{DynamicResource Col_ViewDetailsTooltip}"
                                                            Command="{Binding DataContext.ShowMesDetailCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                            CommandParameter="{Binding}">
                                                        <StackPanel Orientation="Horizontal" IsHitTestVisible="False">
                                                            <Path Data="{StaticResource IconInspectGeometry}"
                                                                  Width="12" Height="12" Stretch="Uniform"
                                                                  Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                                                  VerticalAlignment="Center"
                                                                  Margin="0,0,4,0"/>
                                                            <TextBlock Text="{DynamicResource Col_ViewDetailsBtn}" VerticalAlignment="Center"/>
                                                        </StackPanel>
                                                    </Button>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                    </DataGrid.Columns>
                                </DataGrid>

                                <!-- State 4: Loading State Card (Visible when DataGrid has no items AND IsBusy=True) -->
                                <Border Background="{StaticResource SurfaceElevatedBrush}"
                                        BorderBrush="{StaticResource AccentBorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="8"
                                        Padding="24"
                                        MaxWidth="360"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        IsHitTestVisible="False"
                                        Panel.ZIndex="5">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <MultiDataTrigger>
                                                    <MultiDataTrigger.Conditions>
                                                        <Condition Binding="{Binding HasItems, ElementName=dgResults}" Value="False"/>
                                                        <Condition Binding="{Binding IsBusy}" Value="True"/>
                                                    </MultiDataTrigger.Conditions>
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </MultiDataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <StackPanel HorizontalAlignment="Center">
                                        <Path Data="{StaticResource IconRefreshGeometry}"
                                              Width="28" Height="28" Stretch="Uniform"
                                              Fill="{StaticResource AccentCyanBrush}"
                                              HorizontalAlignment="Center"
                                              Margin="0,0,0,12"
                                              RenderTransformOrigin="0.5,0.5">
                                            <Path.RenderTransform>
                                                <RotateTransform Angle="0"/>
                                            </Path.RenderTransform>
                                            <Path.Style>
                                                <Style TargetType="Path">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsBusy}" Value="True">
                                                            <DataTrigger.EnterActions>
                                                                <BeginStoryboard x:Name="GridLoadingSpinStoryboard">
                                                                    <Storyboard RepeatBehavior="Forever">
                                                                        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)"
                                                                                         From="0" To="360" Duration="0:0:0.9"/>
                                                                    </Storyboard>
                                                                </BeginStoryboard>
                                                            </DataTrigger.EnterActions>
                                                            <DataTrigger.ExitActions>
                                                                <StopStoryboard BeginStoryboardName="GridLoadingSpinStoryboard"/>
                                                            </DataTrigger.ExitActions>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Path.Style>
                                        </Path>
                                        <TextBlock Text="{DynamicResource Status_ReadingLogs}"
                                                   FontSize="16"
                                                   FontWeight="Bold"
                                                   Foreground="{StaticResource TextPrimaryBrush}"
                                                   HorizontalAlignment="Center"
                                                   TextAlignment="Center"/>
                                    </StackPanel>
                                </Border>

                                <!-- State 5: Actionable Empty State Card (Visible when DataGrid has no items AND IsBusy=False) -->
                                <Border Background="{StaticResource SurfaceElevatedBrush}"
                                        BorderBrush="{StaticResource BorderHairlineBrush}"
                                        BorderThickness="1"
                                        CornerRadius="8"
                                        Padding="24"
                                        MaxWidth="440"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        Panel.ZIndex="5">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <MultiDataTrigger>
                                                    <MultiDataTrigger.Conditions>
                                                        <Condition Binding="{Binding HasItems, ElementName=dgResults}" Value="False"/>
                                                        <Condition Binding="{Binding IsBusy}" Value="False"/>
                                                    </MultiDataTrigger.Conditions>
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </MultiDataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <StackPanel HorizontalAlignment="Center">
                                        <Border Width="48" Height="48"
                                                CornerRadius="24"
                                                Background="{StaticResource AccentTintBrush}"
                                                BorderBrush="{StaticResource AccentBorderBrush}"
                                                BorderThickness="1"
                                                HorizontalAlignment="Center"
                                                Margin="0,0,0,12">
                                            <Path Data="{StaticResource IconListGeometry}"
                                                  Width="20" Height="20" Stretch="Uniform"
                                                  Fill="{StaticResource AccentCyanBrush}"
                                                  HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"/>
                                        </Border>
                                        <TextBlock Text="{DynamicResource Filter_ShowingZero}"
                                                   FontSize="16"
                                                   FontWeight="Bold"
                                                   Foreground="{StaticResource TextPrimaryBrush}"
                                                   HorizontalAlignment="Center"
                                                   TextAlignment="Center"/>
                                        <TextBlock Text="{DynamicResource Status_Ready}"
                                                   FontSize="13"
                                                   Foreground="{StaticResource TextSecondaryBrush}"
                                                   HorizontalAlignment="Center"
                                                   TextAlignment="Center"
                                                   TextWrapping="Wrap"
                                                   Margin="0,8,0,16"/>
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                            <Button Style="{StaticResource PrimaryButtonStyle}"
                                                    MinHeight="32"
                                                    Padding="16,4"
                                                    FontSize="13"
                                                    Margin="0,0,8,0"
                                                    Command="{Binding LoadLogCommand}">
                                                <StackPanel Orientation="Horizontal" IsHitTestVisible="False">
                                                    <Path Data="{StaticResource IconLoadLogGeometry}"
                                                          Width="14" Height="14" Stretch="Uniform"
                                                          Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                                          VerticalAlignment="Center"
                                                          Margin="0,0,6,0"/>
                                                    <TextBlock Text="{DynamicResource Header_ReadLogBtn}" VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </Button>
                                            <Button Style="{StaticResource SecondaryButtonStyle}"
                                                    MinHeight="32"
                                                    Padding="16,4"
                                                    FontSize="13"
                                                    Command="{Binding ClearFilterCommand}">
                                                <StackPanel Orientation="Horizontal" IsHitTestVisible="False">
                                                    <Path Data="{StaticResource IconFilterClearGeometry}"
                                                          Width="14" Height="14" Stretch="Uniform"
                                                          Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                                          VerticalAlignment="Center"
                                                          Margin="0,0,6,0"/>
                                                    <TextBlock Text="{DynamicResource Filter_ClearBtn}" VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </Button>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </Grid>
                    </Border>
                </TabItem>

                <!-- TAB 1: PMNT Statistics (Fault distribution by group A / B) -->
                <TabItem>
                    <TabItem.Header>
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource IconBarChartGeometry}"
                                  Width="13" Height="13" Stretch="Uniform"
                                  Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=TabItem}}"
                                  VerticalAlignment="Center"
                                  Margin="0,0,6,0"/>
                            <TextBlock Text="{DynamicResource Tab_PmntStats}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </TabItem.Header>
                    <Grid Margin="0,8,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1*"/>
                            <ColumnDefinition Width="1*"/>
                        </Grid.ColumnDefinitions>

                        <!-- PMNT-A Group Card -->
                        <Border Grid.Row="0"
                                Grid.Column="0"
                                Background="{StaticResource SurfaceCardBrush}"
                                BorderBrush="{StaticResource BorderHairlineBrush}"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="16"
                                Margin="0,0,8,0">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <StackPanel Grid.Row="0" Margin="0,0,0,12">
                                    <DockPanel>
                                        <TextBlock Text="{DynamicResource Pmnt_ColATitle}"
                                                   FontSize="16"
                                                   FontWeight="Bold"
                                                   Foreground="{StaticResource AccentCyanBrush}"/>
                                        <TextBlock x:Name="lblPmntACount"
                                                   Text="{Binding PmntACountText}"
                                                   Style="{StaticResource TabularTextStyle}"
                                                   FontSize="13"
                                                   FontWeight="SemiBold"
                                                   Foreground="{StaticResource TextSecondaryBrush}"
                                                   VerticalAlignment="Center"
                                                   HorizontalAlignment="Right"/>
                                    </DockPanel>
                                    <TextBlock Text="{DynamicResource Pmnt_ColASubtitle}"
                                               FontSize="11"
                                               Foreground="{StaticResource TextMutedBrush}"
                                               Margin="0,4,0,0"/>
                                </StackPanel>
                                <Grid Grid.Row="1">
                                    <DataGrid x:Name="dgPmntA"
                                              ItemsSource="{Binding PmntAList}"
                                          SelectedItem="{Binding SelectedPmntA, Mode=TwoWay}"
                                          RowStyle="{StaticResource PmntAlarmDataGridRowStyle}"
                                          RowHeight="32"
                                          EnableRowVirtualization="True"
                                          EnableColumnVirtualization="True"
                                          VirtualizingPanel.IsVirtualizing="True"
                                          VirtualizingPanel.VirtualizationMode="Recycling"
                                          VirtualizingPanel.ScrollUnit="Pixel"
                                          VirtualizingPanel.CacheLength="2,2"
                                          VirtualizingPanel.CacheLengthUnit="Page">
                                    <DataGrid.ContextMenu>
                                        <ContextMenu x:Name="cmPmntA">
                                            <MenuItem x:Name="cmiCopyPmntA"
                                                      FontWeight="Bold"
                                                      Command="{Binding CopyPmntNameCommand}">
                                                <MenuItem.Header>
                                                    <StackPanel Orientation="Horizontal">
                                                        <Path Data="{StaticResource IconCopyGeometry}"
                                                              Style="{StaticResource VectorIconPathStyle}"
                                                              Width="12" Height="12"
                                                              Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=MenuItem}}"
                                                              Margin="0,0,7,0"/>
                                                        <TextBlock Text="{DynamicResource Pmnt_CopyCode}" VerticalAlignment="Center"/>
                                                    </StackPanel>
                                                </MenuItem.Header>
                                            </MenuItem>
                                            <MenuItem x:Name="cmiFilterPmntA"
                                                      Command="{Binding FilterByPmntCommand}">
                                                <MenuItem.Header>
                                                    <StackPanel Orientation="Horizontal">
                                                        <Path Data="{StaticResource IconSearchGeometry}"
                                                              Style="{StaticResource VectorIconPathStyle}"
                                                              Width="12" Height="12"
                                                              Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=MenuItem}}"
                                                              Margin="0,0,7,0"/>
                                                        <TextBlock Text="{DynamicResource Pmnt_FilterByThis}" VerticalAlignment="Center"/>
                                                    </StackPanel>
                                                </MenuItem.Header>
                                            </MenuItem>
                                        </ContextMenu>
                                    </DataGrid.ContextMenu>
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Binding="{Binding Name}"
                                                            Width="1.2*"
                                                            ElementStyle="{StaticResource TabularDataGridTextStyle}">
                                            <DataGridTextColumn.Header>
                                                <TextBlock Text="{DynamicResource Col_PmntCode}"
                                                           TextTrimming="CharacterEllipsis"
                                                           ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
                                            </DataGridTextColumn.Header>
                                        </DataGridTextColumn>
                                        <DataGridTemplateColumn Width="1.35*"
                                                                SortMemberPath="Count"
                                                                ClipboardContentBinding="{Binding Count}">
                                            <DataGridTemplateColumn.Header>
                                                <TextBlock Text="{DynamicResource Pmnt_ColDefectCount}"
                                                           TextTrimming="CharacterEllipsis"
                                                           ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
                                            </DataGridTemplateColumn.Header>
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <Grid Margin="2,4" ClipToBounds="True">
                                                        <Border Style="{StaticResource GpuDataBarTrackStyle}"
                                                                Background="{StaticResource DataBarTrackABrush}">
                                                            <Border.RenderTransform>
                                                                <ScaleTransform ScaleX="{Binding CountRatio, Mode=OneWay}" ScaleY="1"/>
                                                            </Border.RenderTransform>
                                                        </Border>
                                                        <DockPanel VerticalAlignment="Center" Margin="8,0">
                                                            <TextBlock Text="{Binding Count}"
                                                                       Style="{StaticResource TabularTextStyle}"
                                                                       FontWeight="SemiBold"
                                                                       VerticalAlignment="Center"/>
                                                            <TextBlock Text="{Binding CountPercent, StringFormat={}{0:F0}%}"
                                                                       Style="{StaticResource TabularTextStyle}"
                                                                       FontSize="11"
                                                                       Foreground="{StaticResource TextSecondaryBrush}"
                                                                       HorizontalAlignment="Right"
                                                                       VerticalAlignment="Center"/>
                                                        </DockPanel>
                                                    </Grid>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                        <DataGridTemplateColumn Width="1*"
                                                                SortMemberPath="Streak"
                                                                ClipboardContentBinding="{Binding Streak}">
                                            <DataGridTemplateColumn.Header>
                                                <TextBlock Text="{DynamicResource Pmnt_ColCurrentStreak}"
                                                           TextTrimming="CharacterEllipsis"
                                                           ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
                                            </DataGridTemplateColumn.Header>
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <Border CornerRadius="6"
                                                            Padding="8,2"
                                                            HorizontalAlignment="Left"
                                                            VerticalAlignment="Center"
                                                            BorderThickness="1">
                                                        <Border.Style>
                                                            <Style TargetType="Border">
                                                                <Setter Property="Background" Value="Transparent"/>
                                                                <Setter Property="BorderBrush" Value="Transparent"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsAlarm}" Value="True">
                                                                        <Setter Property="Background" Value="{StaticResource FailTintBrush}"/>
                                                                        <Setter Property="BorderBrush" Value="{StaticResource FailBrush}"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Border.Style>
                                                        <TextBlock Text="{Binding Streak}">
                                                            <TextBlock.Style>
                                                                <Style TargetType="TextBlock" BasedOn="{StaticResource TabularTextStyle}">
                                                                    <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding IsAlarm}" Value="True">
                                                                            <Setter Property="Foreground" Value="{StaticResource FailTextBrush}"/>
                                                                            <Setter Property="FontWeight" Value="Bold"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </TextBlock.Style>
                                                        </TextBlock>
                                                    </Border>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                        <DataGridTextColumn Binding="{Binding MaxStreak}"
                                                            Width="1*"
                                                            ElementStyle="{StaticResource TabularDataGridTextStyle}">
                                            <DataGridTextColumn.Header>
                                                <TextBlock Text="{DynamicResource Pmnt_ColMaxStreak}"
                                                           TextTrimming="CharacterEllipsis"
                                                           ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
                                            </DataGridTextColumn.Header>
                                        </DataGridTextColumn>
                                    </DataGrid.Columns>
                                </DataGrid>
                                <TextBlock Text="{DynamicResource Filter_ShowingZero}"
                                           FontSize="13"
                                           FontWeight="SemiBold"
                                           Foreground="{StaticResource TextSecondaryBrush}"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           IsHitTestVisible="False">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding HasItems, ElementName=dgPmntA}" Value="False">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                </Grid>
                            </Grid>
                        </Border>

                        <!-- PMNT-B Group Card -->
                        <Border Grid.Row="0"
                                Grid.Column="1"
                                Background="{StaticResource SurfaceCardBrush}"
                                BorderBrush="{StaticResource BorderHairlineBrush}"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="16"
                                Margin="8,0,0,0">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <StackPanel Grid.Row="0" Margin="0,0,0,12">
                                    <DockPanel>
                                        <TextBlock Text="{DynamicResource Pmnt_ColBTitle}"
                                                   FontSize="16"
                                                   FontWeight="Bold"
                                                   Foreground="{StaticResource FailTextBrush}"/>
                                        <TextBlock x:Name="lblPmntBCount"
                                                   Text="{Binding PmntBCountText}"
                                                   Style="{StaticResource TabularTextStyle}"
                                                   FontSize="13"
                                                   FontWeight="SemiBold"
                                                   Foreground="{StaticResource TextSecondaryBrush}"
                                                   VerticalAlignment="Center"
                                                   HorizontalAlignment="Right"/>
                                    </DockPanel>
                                    <TextBlock Text="{DynamicResource Pmnt_ColBSubtitle}"
                                               FontSize="11"
                                               Foreground="{StaticResource TextMutedBrush}"
                                               Margin="0,4,0,0"/>
                                </StackPanel>
                                <Grid Grid.Row="1">
                                    <DataGrid x:Name="dgPmntB"
                                              ItemsSource="{Binding PmntBList}"
                                          SelectedItem="{Binding SelectedPmntB, Mode=TwoWay}"
                                          RowStyle="{StaticResource PmntAlarmDataGridRowStyle}"
                                          RowHeight="32"
                                          EnableRowVirtualization="True"
                                          EnableColumnVirtualization="True"
                                          VirtualizingPanel.IsVirtualizing="True"
                                          VirtualizingPanel.VirtualizationMode="Recycling"
                                          VirtualizingPanel.ScrollUnit="Pixel"
                                          VirtualizingPanel.CacheLength="2,2"
                                          VirtualizingPanel.CacheLengthUnit="Page">
                                    <DataGrid.ContextMenu>
                                        <ContextMenu x:Name="cmPmntB">
                                            <MenuItem x:Name="cmiCopyPmntB"
                                                      FontWeight="Bold"
                                                      Command="{Binding CopyPmntNameCommand}">
                                                <MenuItem.Header>
                                                    <StackPanel Orientation="Horizontal">
                                                        <Path Data="{StaticResource IconCopyGeometry}"
                                                              Style="{StaticResource VectorIconPathStyle}"
                                                              Width="12" Height="12"
                                                              Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=MenuItem}}"
                                                              Margin="0,0,7,0"/>
                                                        <TextBlock Text="{DynamicResource Pmnt_CopyCode}" VerticalAlignment="Center"/>
                                                    </StackPanel>
                                                </MenuItem.Header>
                                            </MenuItem>
                                            <MenuItem x:Name="cmiFilterPmntB"
                                                      Command="{Binding FilterByPmntCommand}">
                                                <MenuItem.Header>
                                                    <StackPanel Orientation="Horizontal">
                                                        <Path Data="{StaticResource IconSearchGeometry}"
                                                              Style="{StaticResource VectorIconPathStyle}"
                                                              Width="12" Height="12"
                                                              Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=MenuItem}}"
                                                              Margin="0,0,7,0"/>
                                                        <TextBlock Text="{DynamicResource Pmnt_FilterByThis}" VerticalAlignment="Center"/>
                                                    </StackPanel>
                                                </MenuItem.Header>
                                            </MenuItem>
                                        </ContextMenu>
                                    </DataGrid.ContextMenu>
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Binding="{Binding Name}"
                                                            Width="1.2*"
                                                            ElementStyle="{StaticResource TabularDataGridTextStyle}">
                                            <DataGridTextColumn.Header>
                                                <TextBlock Text="{DynamicResource Col_PmntCode}"
                                                           TextTrimming="CharacterEllipsis"
                                                           ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
                                            </DataGridTextColumn.Header>
                                        </DataGridTextColumn>
                                        <DataGridTemplateColumn Width="1.35*"
                                                                SortMemberPath="Count"
                                                                ClipboardContentBinding="{Binding Count}">
                                            <DataGridTemplateColumn.Header>
                                                <TextBlock Text="{DynamicResource Pmnt_ColDefectCount}"
                                                           TextTrimming="CharacterEllipsis"
                                                           ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
                                            </DataGridTemplateColumn.Header>
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <Grid Margin="2,4" ClipToBounds="True">
                                                        <Border Style="{StaticResource GpuDataBarTrackStyle}"
                                                                Background="{StaticResource DataBarTrackBBrush}">
                                                            <Border.RenderTransform>
                                                                <ScaleTransform ScaleX="{Binding CountRatio, Mode=OneWay}" ScaleY="1"/>
                                                            </Border.RenderTransform>
                                                        </Border>
                                                        <DockPanel VerticalAlignment="Center" Margin="8,0">
                                                            <TextBlock Text="{Binding Count}"
                                                                       Style="{StaticResource TabularTextStyle}"
                                                                       FontWeight="SemiBold"
                                                                       VerticalAlignment="Center"/>
                                                            <TextBlock Text="{Binding CountPercent, StringFormat={}{0:F0}%}"
                                                                       Style="{StaticResource TabularTextStyle}"
                                                                       FontSize="11"
                                                                       Foreground="{StaticResource TextSecondaryBrush}"
                                                                       HorizontalAlignment="Right"
                                                                       VerticalAlignment="Center"/>
                                                        </DockPanel>
                                                    </Grid>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                        <DataGridTemplateColumn Width="1*"
                                                                SortMemberPath="Streak"
                                                                ClipboardContentBinding="{Binding Streak}">
                                            <DataGridTemplateColumn.Header>
                                                <TextBlock Text="{DynamicResource Pmnt_ColCurrentStreak}"
                                                           TextTrimming="CharacterEllipsis"
                                                           ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
                                            </DataGridTemplateColumn.Header>
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <Border CornerRadius="6"
                                                            Padding="8,2"
                                                            HorizontalAlignment="Left"
                                                            VerticalAlignment="Center"
                                                            BorderThickness="1">
                                                        <Border.Style>
                                                            <Style TargetType="Border">
                                                                <Setter Property="Background" Value="Transparent"/>
                                                                <Setter Property="BorderBrush" Value="Transparent"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsAlarm}" Value="True">
                                                                        <Setter Property="Background" Value="{StaticResource FailTintBrush}"/>
                                                                        <Setter Property="BorderBrush" Value="{StaticResource FailBrush}"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Border.Style>
                                                        <TextBlock Text="{Binding Streak}">
                                                            <TextBlock.Style>
                                                                <Style TargetType="TextBlock" BasedOn="{StaticResource TabularTextStyle}">
                                                                    <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding IsAlarm}" Value="True">
                                                                            <Setter Property="Foreground" Value="{StaticResource FailTextBrush}"/>
                                                                            <Setter Property="FontWeight" Value="Bold"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </TextBlock.Style>
                                                        </TextBlock>
                                                    </Border>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                        <DataGridTextColumn Binding="{Binding MaxStreak}"
                                                            Width="1*"
                                                            ElementStyle="{StaticResource TabularDataGridTextStyle}">
                                            <DataGridTextColumn.Header>
                                                <TextBlock Text="{DynamicResource Pmnt_ColMaxStreak}"
                                                           TextTrimming="CharacterEllipsis"
                                                           ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
                                            </DataGridTextColumn.Header>
                                        </DataGridTextColumn>
                                    </DataGrid.Columns>
                                </DataGrid>
                                <TextBlock Text="{DynamicResource Filter_ShowingZero}"
                                           FontSize="13"
                                           FontWeight="SemiBold"
                                           Foreground="{StaticResource TextSecondaryBrush}"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           IsHitTestVisible="False">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding HasItems, ElementName=dgPmntB}" Value="False">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                </Grid>
                            </Grid>
                        </Border>

                        <!-- PMNT-OTHER Group Card (visible only when non-A/B PMNT defects exist) -->
                        <Border Grid.Row="1"
                                Grid.ColumnSpan="2"
                                Background="{StaticResource SurfaceCardBrush}"
                                BorderBrush="{StaticResource BorderHairlineBrush}"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="16"
                                Margin="0,12,0,0"
                                MaxHeight="190"
                                Visibility="{Binding HasPmntOther, Converter={StaticResource BoolToVis}}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <DockPanel Grid.Row="0" Margin="0,0,0,8">
                                    <TextBlock Text="{DynamicResource Pmnt_ColOtherTitle}"
                                               FontSize="16"
                                               FontWeight="Bold"
                                               Foreground="{StaticResource TextPrimaryBrush}"/>
                                    <TextBlock x:Name="lblPmntOtherCount"
                                               Text="{Binding PmntOtherCountText}"
                                               Style="{StaticResource TabularTextStyle}"
                                               FontSize="13"
                                               FontWeight="SemiBold"
                                               Foreground="{StaticResource TextSecondaryBrush}"
                                               VerticalAlignment="Center"
                                               HorizontalAlignment="Right"/>
                                </DockPanel>
                                <DataGrid Grid.Row="1"
                                          x:Name="dgPmntOther"
                                          ItemsSource="{Binding PmntOtherList}"
                                          SelectedItem="{Binding SelectedPmntOther, Mode=TwoWay}"
                                          RowStyle="{StaticResource PmntAlarmDataGridRowStyle}"
                                          RowHeight="32"
                                          EnableRowVirtualization="True"
                                          EnableColumnVirtualization="True"
                                          VirtualizingPanel.IsVirtualizing="True"
                                          VirtualizingPanel.VirtualizationMode="Recycling"
                                          VirtualizingPanel.ScrollUnit="Pixel"
                                          VirtualizingPanel.CacheLength="2,2"
                                          VirtualizingPanel.CacheLengthUnit="Page">
                                    <DataGrid.ContextMenu>
                                        <ContextMenu x:Name="cmPmntOther">
                                            <MenuItem x:Name="cmiCopyPmntOther"
                                                      FontWeight="Bold"
                                                      Command="{Binding CopyPmntNameCommand}">
                                                <MenuItem.Header>
                                                    <StackPanel Orientation="Horizontal">
                                                        <Path Data="{StaticResource IconCopyGeometry}"
                                                              Style="{StaticResource VectorIconPathStyle}"
                                                              Width="12" Height="12"
                                                              Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=MenuItem}}"
                                                              Margin="0,0,7,0"/>
                                                        <TextBlock Text="{DynamicResource Pmnt_CopyCode}" VerticalAlignment="Center"/>
                                                    </StackPanel>
                                                </MenuItem.Header>
                                            </MenuItem>
                                            <MenuItem x:Name="cmiFilterPmntOther"
                                                      Command="{Binding FilterByPmntCommand}">
                                                <MenuItem.Header>
                                                    <StackPanel Orientation="Horizontal">
                                                        <Path Data="{StaticResource IconSearchGeometry}"
                                                              Style="{StaticResource VectorIconPathStyle}"
                                                              Width="12" Height="12"
                                                              Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=MenuItem}}"
                                                              Margin="0,0,7,0"/>
                                                        <TextBlock Text="{DynamicResource Pmnt_FilterByThis}" VerticalAlignment="Center"/>
                                                    </StackPanel>
                                                </MenuItem.Header>
                                            </MenuItem>
                                        </ContextMenu>
                                    </DataGrid.ContextMenu>
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Binding="{Binding Name}"
                                                            Width="1.2*"
                                                            ElementStyle="{StaticResource TabularDataGridTextStyle}">
                                            <DataGridTextColumn.Header>
                                                <TextBlock Text="{DynamicResource Col_PmntCode}"
                                                           TextTrimming="CharacterEllipsis"
                                                           ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
                                            </DataGridTextColumn.Header>
                                        </DataGridTextColumn>
                                        <DataGridTemplateColumn Width="1.35*"
                                                                SortMemberPath="Count"
                                                                ClipboardContentBinding="{Binding Count}">
                                            <DataGridTemplateColumn.Header>
                                                <TextBlock Text="{DynamicResource Pmnt_ColDefectCount}"
                                                           TextTrimming="CharacterEllipsis"
                                                           ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
                                            </DataGridTemplateColumn.Header>
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <Grid Margin="2,4" ClipToBounds="True">
                                                        <Border Style="{StaticResource GpuDataBarTrackStyle}"
                                                                Background="{StaticResource DataBarTrackABrush}">
                                                            <Border.RenderTransform>
                                                                <ScaleTransform ScaleX="{Binding CountRatio, Mode=OneWay}" ScaleY="1"/>
                                                            </Border.RenderTransform>
                                                        </Border>
                                                        <DockPanel VerticalAlignment="Center" Margin="8,0">
                                                            <TextBlock Text="{Binding Count}"
                                                                       Style="{StaticResource TabularTextStyle}"
                                                                       FontWeight="SemiBold"
                                                                       VerticalAlignment="Center"/>
                                                            <TextBlock Text="{Binding CountPercent, StringFormat={}{0:F0}%}"
                                                                       Style="{StaticResource TabularTextStyle}"
                                                                       FontSize="11"
                                                                       Foreground="{StaticResource TextSecondaryBrush}"
                                                                       HorizontalAlignment="Right"
                                                                       VerticalAlignment="Center"/>
                                                        </DockPanel>
                                                    </Grid>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                        <DataGridTemplateColumn Width="1*"
                                                                SortMemberPath="Streak"
                                                                ClipboardContentBinding="{Binding Streak}">
                                            <DataGridTemplateColumn.Header>
                                                <TextBlock Text="{DynamicResource Pmnt_ColCurrentStreak}"
                                                           TextTrimming="CharacterEllipsis"
                                                           ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
                                            </DataGridTemplateColumn.Header>
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <Border CornerRadius="6"
                                                            Padding="8,2"
                                                            HorizontalAlignment="Left"
                                                            VerticalAlignment="Center"
                                                            BorderThickness="1">
                                                        <Border.Style>
                                                            <Style TargetType="Border">
                                                                <Setter Property="Background" Value="Transparent"/>
                                                                <Setter Property="BorderBrush" Value="Transparent"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsAlarm}" Value="True">
                                                                        <Setter Property="Background" Value="{StaticResource FailTintBrush}"/>
                                                                        <Setter Property="BorderBrush" Value="{StaticResource FailBrush}"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Border.Style>
                                                        <TextBlock Text="{Binding Streak}">
                                                            <TextBlock.Style>
                                                                <Style TargetType="TextBlock" BasedOn="{StaticResource TabularTextStyle}">
                                                                    <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding IsAlarm}" Value="True">
                                                                            <Setter Property="Foreground" Value="{StaticResource FailTextBrush}"/>
                                                                            <Setter Property="FontWeight" Value="Bold"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </TextBlock.Style>
                                                        </TextBlock>
                                                    </Border>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                        <DataGridTextColumn Binding="{Binding MaxStreak}"
                                                            Width="1*"
                                                            ElementStyle="{StaticResource TabularDataGridTextStyle}">
                                            <DataGridTextColumn.Header>
                                                <TextBlock Text="{DynamicResource Pmnt_ColMaxStreak}"
                                                           TextTrimming="CharacterEllipsis"
                                                           ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
                                            </DataGridTextColumn.Header>
                                        </DataGridTextColumn>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </Grid>
                        </Border>
                    </Grid>
                </TabItem>

                <!-- TAB 2: Defect Trend Chart (SelectedIndex == 2) -->
                <TabItem>
                    <TabItem.Header>
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource IconTrendChartGeometry}"
                                  Width="13" Height="13" Stretch="Uniform"
                                  Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=TabItem}}"
                                  VerticalAlignment="Center"
                                  Margin="0,0,6,0"/>
                            <TextBlock Text="{DynamicResource Tab_DefectChart}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </TabItem.Header>
                    <Grid Margin="0,8,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- Chart Toolbar & Legend Card -->
                        <Border Grid.Row="0"
                                Background="{StaticResource SurfaceCardBrush}"
                                BorderBrush="{StaticResource BorderHairlineBrush}"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="12,8"
                                Margin="0,0,0,8">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <WrapPanel Grid.Column="0" VerticalAlignment="Center">
                                    <!-- Unified Chart Display Mode Segmented Control -->
                                    <StackPanel Orientation="Horizontal" Margin="0,4,12,4" VerticalAlignment="Center">
                                        <TextBlock Text="{DynamicResource Chart_Mode}"
                                                   Foreground="{StaticResource TextSecondaryBrush}"
                                                   VerticalAlignment="Center"
                                                   Margin="0,0,8,0"
                                                   FontSize="13"/>
                                        <Border Background="{StaticResource SurfaceInputBrush}"
                                                BorderBrush="{StaticResource BorderHairlineBrush}"
                                                BorderThickness="1"
                                                CornerRadius="6"
                                                Padding="2"
                                                MinHeight="32"
                                                VerticalAlignment="Center">
                                            <StackPanel Orientation="Horizontal">
                                                <Button x:Name="btnChartModeTimeline"
                                                        Padding="10,2"
                                                        MinHeight="26"
                                                        FontSize="13"
                                                        Margin="0,0,2,0"
                                                        ToolTip="{DynamicResource Chart_TimelineTooltip}"
                                                        Command="{Binding Chart.SetTimelineModeCommand}">
                                                    <Button.Style>
                                                        <Style TargetType="Button" BasedOn="{StaticResource SegmentedItemButtonStyle}">
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Chart.SelectedDisplayModeIndex}" Value="0">
                                                                    <Setter Property="Background" Value="{StaticResource AccentTintBrush}"/>
                                                                    <Setter Property="BorderBrush" Value="{StaticResource AccentBorderBrush}"/>
                                                                    <Setter Property="Foreground" Value="{StaticResource AccentCyanBrush}"/>
                                                                    <Setter Property="FontWeight" Value="Bold"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Button.Style>
                                                    <StackPanel Orientation="Horizontal" IsHitTestVisible="False">
                                                        <Path Data="{StaticResource IconTrendChartGeometry}"
                                                              Width="14" Height="14" Stretch="Uniform"
                                                              Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                                              VerticalAlignment="Center"
                                                              Margin="0,0,6,0"/>
                                                        <TextBlock Text="{DynamicResource Chart_TimelineBtn}" VerticalAlignment="Center"/>
                                                    </StackPanel>
                                                </Button>
                                                <Button x:Name="btnChartModePareto"
                                                        Padding="10,2"
                                                        MinHeight="26"
                                                        FontSize="13"
                                                        Margin="0,0,2,0"
                                                        ToolTip="{DynamicResource Chart_ParetoTooltip}"
                                                        Command="{Binding Chart.SetParetoModeCommand}">
                                                    <Button.Style>
                                                        <Style TargetType="Button" BasedOn="{StaticResource SegmentedItemButtonStyle}">
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Chart.SelectedDisplayModeIndex}" Value="1">
                                                                    <Setter Property="Background" Value="{StaticResource AccentTintBrush}"/>
                                                                    <Setter Property="BorderBrush" Value="{StaticResource AccentBorderBrush}"/>
                                                                    <Setter Property="Foreground" Value="{StaticResource AccentCyanBrush}"/>
                                                                    <Setter Property="FontWeight" Value="Bold"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Button.Style>
                                                    <StackPanel Orientation="Horizontal" IsHitTestVisible="False">
                                                        <Path Data="{StaticResource IconBarChartGeometry}"
                                                              Width="14" Height="14" Stretch="Uniform"
                                                              Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                                              VerticalAlignment="Center"
                                                              Margin="0,0,6,0"/>
                                                        <TextBlock Text="{DynamicResource Chart_ParetoBtn}" VerticalAlignment="Center"/>
                                                    </StackPanel>
                                                </Button>
                                                <Button x:Name="btnChartModeHourly"
                                                        Padding="10,2"
                                                        MinHeight="26"
                                                        FontSize="13"
                                                        ToolTip="{DynamicResource Chart_HourlyTooltip}"
                                                        Command="{Binding Chart.SetHourlyModeCommand}">
                                                    <Button.Style>
                                                        <Style TargetType="Button" BasedOn="{StaticResource SegmentedItemButtonStyle}">
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Chart.SelectedDisplayModeIndex}" Value="2">
                                                                    <Setter Property="Background" Value="{StaticResource AccentTintBrush}"/>
                                                                    <Setter Property="BorderBrush" Value="{StaticResource AccentBorderBrush}"/>
                                                                    <Setter Property="Foreground" Value="{StaticResource AccentCyanBrush}"/>
                                                                    <Setter Property="FontWeight" Value="Bold"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Button.Style>
                                                    <StackPanel Orientation="Horizontal" IsHitTestVisible="False">
                                                        <Path Data="{StaticResource IconRefreshGeometry}"
                                                              Width="14" Height="14" Stretch="Uniform"
                                                              Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                                              VerticalAlignment="Center"
                                                              Margin="0,0,6,0"/>
                                                        <TextBlock Text="{DynamicResource Chart_HourlyBtn}" VerticalAlignment="Center"/>
                                                    </StackPanel>
                                                </Button>
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>

                                    <StackPanel Orientation="Horizontal" Margin="0,4,12,4" VerticalAlignment="Center">
                                        <TextBlock Text="{DynamicResource Chart_PmntGroup}"
                                                   Foreground="{StaticResource TextSecondaryBrush}"
                                                   VerticalAlignment="Center"
                                                   Margin="0,0,8,0"
                                                   FontSize="13"/>
                                        <ComboBox x:Name="cmbChartGroup"
                                                  MinWidth="156"
                                                  MinHeight="32"
                                                  FontSize="13"
                                                  SelectedIndex="{Binding Chart.SelectedGroupIndex, Mode=TwoWay}">
                                            <ComboBoxItem Content="{DynamicResource Chart_GroupAll}" Tag="ALL"/>
                                            <ComboBoxItem Content="{DynamicResource Chart_GroupA}" Tag="A"/>
                                            <ComboBoxItem Content="{DynamicResource Chart_GroupB}" Tag="B"/>
                                            <ComboBoxItem Content="{DynamicResource Chart_GroupOther}" Tag="OTHER"/>
                                        </ComboBox>
                                    </StackPanel>

                                    <StackPanel Orientation="Horizontal" Margin="0,4,12,4" VerticalAlignment="Center">
                                        <TextBlock Text="{DynamicResource Chart_DefectType}"
                                                   Foreground="{StaticResource TextSecondaryBrush}"
                                                   VerticalAlignment="Center"
                                                   Margin="0,0,8,0"
                                                   FontSize="13"/>
                                        <ComboBox x:Name="cmbChartDefect"
                                                  MinWidth="136"
                                                  MinHeight="32"
                                                  FontSize="13"
                                                  SelectedIndex="{Binding Chart.SelectedDefectIndex, Mode=TwoWay}">
                                            <ComboBoxItem Content="{DynamicResource Chart_DefectAll}" Tag="ALL"/>
                                            <ComboBoxItem Content="{DynamicResource Chart_DefectXylv}" Tag="XYLV"/>
                                            <ComboBoxItem Content="{DynamicResource Chart_DefectPowerOn}" Tag="POWERON"/>
                                            <ComboBoxItem Content="{DynamicResource Chart_DefectPowerOff}" Tag="POWEROFF"/>
                                            <ComboBoxItem Content="{DynamicResource Chart_DefectFlicker}" Tag="FLICKER"/>
                                        </ComboBox>
                                    </StackPanel>

                                    <CheckBox x:Name="chkChartLines"
                                              Content="{DynamicResource Chart_ConnectLines}"
                                              IsChecked="{Binding Chart.ShowLines, Mode=TwoWay}"
                                              VerticalAlignment="Center"
                                              Margin="0,4,12,4"
                                              FontSize="13"/>
                                    <CheckBox x:Name="chkChartLabels"
                                              Content="{DynamicResource Chart_ShowLabels}"
                                              IsChecked="{Binding Chart.ShowLabels, Mode=TwoWay}"
                                              VerticalAlignment="Center"
                                              Margin="0,4,12,4"
                                              FontSize="13"/>

                                    <!-- Zoom Controls -->
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,4,12,4">
                                        <TextBlock Text="{DynamicResource Chart_Zoom}"
                                                   Foreground="{StaticResource TextSecondaryBrush}"
                                                   VerticalAlignment="Center"
                                                   Margin="0,0,8,0"
                                                   FontSize="13"/>
                                        <Button x:Name="btnChartZoomOut"
                                                Style="{StaticResource SecondaryButtonStyle}"
                                                Width="32" Height="32"
                                                Padding="0"
                                                ToolTip="{DynamicResource Chart_ZoomOutTooltip}"
                                                Command="{Binding Chart.ZoomOutCommand}">
                                            <Path Data="{StaticResource IconZoomOutGeometry}"
                                                  Width="14" Height="14" Stretch="Uniform"
                                                  Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                                  IsHitTestVisible="False"/>
                                        </Button>
                                        <Border Background="{StaticResource SurfaceInputBrush}"
                                                BorderBrush="{StaticResource BorderHairlineBrush}"
                                                BorderThickness="1"
                                                CornerRadius="6"
                                                MinHeight="32"
                                                Padding="8,4"
                                                Margin="4,0">
                                            <TextBlock x:Name="lblChartZoom"
                                                       Text="{Binding Chart.ZoomText}"
                                                       Style="{StaticResource TabularTextStyle}"
                                                       Foreground="{StaticResource AccentCyanBrush}"
                                                       FontSize="13"
                                                       FontWeight="Bold"
                                                       MinWidth="40"
                                                       TextAlignment="Center"
                                                       VerticalAlignment="Center"/>
                                        </Border>
                                        <Button x:Name="btnChartZoomIn"
                                                Style="{StaticResource SecondaryButtonStyle}"
                                                Width="32" Height="32"
                                                Padding="0"
                                                ToolTip="{DynamicResource Chart_ZoomInTooltip}"
                                                Command="{Binding Chart.ZoomInCommand}">
                                            <Path Data="{StaticResource IconZoomInGeometry}"
                                                  Width="14" Height="14" Stretch="Uniform"
                                                  Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                                  IsHitTestVisible="False"/>
                                        </Button>
                                        <Button x:Name="btnChartZoomReset"
                                                Style="{StaticResource SecondaryButtonStyle}"
                                                MinHeight="32"
                                                Padding="12,4"
                                                FontSize="13"
                                                Margin="8,0,0,0"
                                                ToolTip="{DynamicResource Chart_FitFrameTooltip}"
                                                Command="{Binding Chart.ZoomResetCommand}">
                                            <StackPanel Orientation="Horizontal" IsHitTestVisible="False">
                                                <Path Data="{StaticResource IconZoomResetGeometry}"
                                                      Width="14" Height="14" Stretch="Uniform"
                                                      Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                                      VerticalAlignment="Center"
                                                      Margin="0,0,6,0"/>
                                                <TextBlock Text="{DynamicResource Chart_FitFrameBtn}" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Button>
                                    </StackPanel>

                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,4,0,4">
                                        <Ellipse Width="8" Height="8" Fill="{StaticResource AccentCyanBrush}" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                        <TextBlock Text="PMNT-A" Foreground="{StaticResource AccentCyanBrush}" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                        <Ellipse Width="8" Height="8" Fill="{StaticResource FailBrush}" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                        <TextBlock Text="PMNT-B" Foreground="{StaticResource FailTextBrush}" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                        <Path Data="{StaticResource IconInfoGeometry}"
                                              Style="{StaticResource VectorIconPathStyle}"
                                              Width="12" Height="12"
                                              Fill="{StaticResource AccentCyanBrush}"
                                              Margin="0,0,4,0"/>
                                        <TextBlock Text="{DynamicResource Chart_InteractionHint}"
                                                   Foreground="{StaticResource TextMutedBrush}"
                                                   FontSize="11"
                                                   VerticalAlignment="Center"/>
                                    </StackPanel>
                                </WrapPanel>

                                <!-- Isolated Chart Summary Pill (prevents clipping/truncation) -->
                                <Border Grid.Column="1"
                                        Background="{StaticResource SurfaceInputBrush}"
                                        BorderBrush="{StaticResource BorderHairlineBrush}"
                                        BorderThickness="1"
                                        CornerRadius="6"
                                        Padding="12,4"
                                        MinHeight="32"
                                        MaxWidth="360"
                                        Margin="12,4,0,4"
                                        VerticalAlignment="Center"
                                        ToolTip="{Binding Chart.SummaryText}">
                                    <TextBlock x:Name="lblChartSummary"
                                               Text="{Binding Chart.SummaryText}"
                                               Style="{StaticResource TabularTextStyle}"
                                               Foreground="{StaticResource AccentCyanBrush}"
                                               FontWeight="Bold"
                                               FontSize="13"
                                               VerticalAlignment="Center"
                                               TextTrimming="CharacterEllipsis"/>
                                </Border>
                            </Grid>
                        </Border>

                        <!-- Chart Vector Canvas Card (Smooth GPU Zoom & Pan without ScrollBars) -->
                        <Border Grid.Row="1"
                                x:Name="bdrChartContainer"
                                Background="{StaticResource SurfaceCardBrush}"
                                BorderBrush="{StaticResource BorderHairlineBrush}"
                                BorderThickness="1"
                                CornerRadius="8"
                                ClipToBounds="True">
                            <Grid ClipToBounds="True">
                                <Canvas x:Name="cvErrorChart" Background="{StaticResource CanvasHitTestBrush}" RenderTransformOrigin="0,0">
                                    <Canvas.RenderTransform>
                                        <TransformGroup>
                                            <ScaleTransform x:Name="chartScaleTransform" ScaleX="1" ScaleY="1"/>
                                            <TranslateTransform x:Name="chartTranslateTransform" X="0" Y="0"/>
                                        </TransformGroup>
                                    </Canvas.RenderTransform>
                                </Canvas>

                                <!-- State 5: Actionable Chart Empty State Card -->
                                <Border Background="{StaticResource SurfaceElevatedBrush}"
                                        BorderBrush="{StaticResource BorderHairlineBrush}"
                                        BorderThickness="1"
                                        CornerRadius="8"
                                        Padding="24"
                                        MaxWidth="440"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        Visibility="{Binding Chart.IsChartEmpty, Converter={StaticResource BoolToVis}}">
                                    <StackPanel HorizontalAlignment="Center">
                                        <Border Width="48" Height="48"
                                                CornerRadius="24"
                                                Background="{StaticResource AccentTintBrush}"
                                                BorderBrush="{StaticResource AccentBorderBrush}"
                                                BorderThickness="1"
                                                HorizontalAlignment="Center"
                                                Margin="0,0,0,12">
                                            <Path Data="{StaticResource IconTrendChartGeometry}"
                                                  Width="20" Height="20" Stretch="Uniform"
                                                  Fill="{StaticResource AccentCyanBrush}"
                                                  HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"/>
                                        </Border>
                                        <TextBlock x:Name="txtChartEmpty"
                                                   Text="{DynamicResource Chart_NoDataRange}"
                                                   FontSize="16"
                                                   FontWeight="Bold"
                                                   Foreground="{StaticResource TextPrimaryBrush}"
                                                   HorizontalAlignment="Center"
                                                   TextAlignment="Center"
                                                   TextWrapping="Wrap"/>
                                        <TextBlock Text="{DynamicResource Status_Ready}"
                                                   FontSize="13"
                                                   Foreground="{StaticResource TextSecondaryBrush}"
                                                   HorizontalAlignment="Center"
                                                   TextAlignment="Center"
                                                   TextWrapping="Wrap"
                                                   Margin="0,8,0,16"/>
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                            <Button Style="{StaticResource PrimaryButtonStyle}"
                                                    MinHeight="32"
                                                    Padding="16,4"
                                                    FontSize="13"
                                                    Margin="0,0,8,0"
                                                    Command="{Binding LoadLogCommand}">
                                                <StackPanel Orientation="Horizontal" IsHitTestVisible="False">
                                                    <Path Data="{StaticResource IconLoadLogGeometry}"
                                                          Width="14" Height="14" Stretch="Uniform"
                                                          Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                                          VerticalAlignment="Center"
                                                          Margin="0,0,6,0"/>
                                                    <TextBlock Text="{DynamicResource Header_ReadLogBtn}" VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </Button>
                                            <Button Style="{StaticResource SecondaryButtonStyle}"
                                                    MinHeight="32"
                                                    Padding="16,4"
                                                    FontSize="13"
                                                    Command="{Binding ClearFilterCommand}">
                                                <StackPanel Orientation="Horizontal" IsHitTestVisible="False">
                                                    <Path Data="{StaticResource IconFilterClearGeometry}"
                                                          Width="14" Height="14" Stretch="Uniform"
                                                          Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                                          VerticalAlignment="Center"
                                                          Margin="0,0,6,0"/>
                                                    <TextBlock Text="{DynamicResource Filter_ClearBtn}" VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </Button>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </Border>
                    </Grid>
                </TabItem>
            </TabControl>

            <!-- ROW 5: Footer Status Bar -->
            <Border Grid.Row="5"
                    Background="{StaticResource SurfaceCardBrush}"
                    BorderBrush="{StaticResource BorderHairlineBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="12,8"
                    Margin="0,8,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock x:Name="txtStatusIndicator"
                                   Text="{Binding StatusIndicatorText}"
                                   Foreground="{Binding StatusIndicatorColor, Converter={StaticResource HexToFrozenBrushConverter}}"
                                   Style="{StaticResource TabularTextStyle}"
                                   FontWeight="SemiBold"/>
                        <Border Width="1" Height="14" Background="{StaticResource BorderHairlineBrush}" Margin="12,0"/>
                    </StackPanel>
                    <TextBlock Grid.Column="1"
                               x:Name="txtFileInfo"
                               Text="{Binding FileInfoText}"
                               ToolTip="{Binding FileInfoText}"
                               Style="{StaticResource TabularTextStyle}"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis"
                               Margin="0,0,16,0"/>
                    <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <TextBlock Text="{DynamicResource Footer_Cameras}"
                                   FontSize="11"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   VerticalAlignment="Center"
                                   Margin="0,0,8,0"/>
                        <ItemsControl x:Name="icCameraHealth" VerticalAlignment="Center" ItemsSource="{Binding CameraHealthItems}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="{StaticResource BorderHairlineBrush}"
                                            BorderThickness="1"
                                            CornerRadius="6"
                                            Padding="8,4"
                                            Margin="0,0,4,0"
                                            ToolTip="{Binding ToolTip}">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="{StaticResource CameraOfflineBgBrush}"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Online}" Value="True">
                                                        <Setter Property="Background" Value="{StaticResource CameraOnlineBgBrush}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Ellipse Width="7" Height="7" Margin="0,0,6,0" VerticalAlignment="Center">
                                                <Ellipse.Style>
                                                    <Style TargetType="Ellipse">
                                                        <Setter Property="Fill" Value="{StaticResource CameraOfflineBrush}"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Online}" Value="True">
                                                                <Setter Property="Fill" Value="{StaticResource CameraOnlineDotBrush}"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Ellipse.Style>
                                            </Ellipse>
                                            <TextBlock Text="{Binding Label}"
                                                       FontSize="11"
                                                       FontWeight="SemiBold">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock" BasedOn="{StaticResource TabularTextStyle}">
                                                        <Setter Property="Foreground" Value="{StaticResource CameraOfflineBrush}"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Online}" Value="True">
                                                                <Setter Property="Foreground" Value="{StaticResource CameraOnlineTextBrush}"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <Button x:Name="btnRefreshCameraHealth"
                                Style="{StaticResource GhostButtonStyle}"
                                Width="28" Height="28"
                                Padding="0"
                                Margin="4,0,8,0"
                                ToolTip="{DynamicResource Footer_ProbeCamerasTooltip}"
                                Command="{Binding RefreshCameraHealthCommand}">
                            <Path Data="{StaticResource IconRefreshGeometry}"
                                  Style="{StaticResource VectorIconPathStyle}"
                                  Width="14" Height="14"
                                  Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                        </Button>
                        <Border Width="1" Height="14" Background="{StaticResource BorderHairlineBrush}" Margin="0,0,8,0"/>
                        <TextBlock x:Name="txtRealtimeStatus"
                                   Text="{Binding RealtimeStatusText}"
                                   Foreground="{Binding RealtimeStatusColor, Converter={StaticResource HexToFrozenBrushConverter}}"
                                   Style="{StaticResource TabularTextStyle}"
                                   FontWeight="SemiBold"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <!-- ================================================================ -->
        <!-- INDUSTRIAL SHOP-FLOOR WALLBOARD OVERLAY (10-Foot UI, F11/Kiosk)  -->
        <!-- ================================================================ -->
        <Grid x:Name="grdWallboardOverlay"
              Background="{StaticResource BgPrimaryBrush}"
              Panel.ZIndex="100"
              Visibility="{Binding IsKioskMode, Converter={StaticResource BoolToVis}}">
            <Grid Margin="16,12">
                <Grid.RowDefinitions>
                    <!-- Row 0: Industrial Top Bar -->
                    <RowDefinition Height="Auto"/>
                    <!-- Row 1: 5 Oversized KPI Hero Cards (5-10m viewing distance) -->
                    <RowDefinition Height="Auto"/>
                    <!-- Row 2: Consecutive NG / Defect Alert Banner -->
                    <RowDefinition Height="Auto"/>
                    <!-- Row 3: 2-Column Shop-Floor Split (62% Left Carousel / 38% Right Live NG Spotlight) -->
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- ROW 0: Industrial Top Bar -->
                <Border Grid.Row="0"
                        Background="{StaticResource SurfaceCardBrush}"
                        BorderBrush="{StaticResource BorderHairlineBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="12,6"
                        Margin="0,0,0,10">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- Branding & Shift Badge -->
                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                            <Border Background="{StaticResource WallboardBrandGradientBrush}"
                                    CornerRadius="8"
                                    Width="36" Height="36"
                                    Margin="0,0,10,0">
                                <Path Data="{StaticResource IconMonitorGeometry}"
                                      Width="18" Height="18" Stretch="Uniform"
                                      Fill="{StaticResource BrandIconFgBrush}"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel VerticalAlignment="Center" MaxWidth="220" Margin="0,0,10,0">
                                <Viewbox StretchDirection="DownOnly" HorizontalAlignment="Left">
                                    <TextBlock Text="{DynamicResource Wall_Title}"
                                               FontSize="17"
                                               FontWeight="Bold"
                                               Foreground="{StaticResource TextPrimaryBrush}"/>
                                </Viewbox>
                                <TextBlock Text="{Binding AppSubtitle}"
                                           FontSize="11"
                                           Foreground="{StaticResource TextSecondaryBrush}"
                                           TextTrimming="CharacterEllipsis"
                                           ToolTip="{Binding AppSubtitle}"/>
                            </StackPanel>
                            <Border Background="{StaticResource WarningTintBrush}"
                                    BorderBrush="{StaticResource WarningBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="6"
                                    Padding="10,4"
                                    VerticalAlignment="Center"
                                    Margin="0,0,10,0">
                                <Viewbox StretchDirection="DownOnly">
                                    <TextBlock Text="{Binding CurrentShiftBadgeText}"
                                               Style="{StaticResource TabularTextStyle}"
                                               FontSize="13"
                                               FontWeight="Bold"
                                               Foreground="{StaticResource WarningTextBrush}"/>
                                </Viewbox>
                            </Border>
                        </StackPanel>

                        <!-- Digital Clock -->
                        <Border Grid.Column="1"
                                Background="{StaticResource SurfaceInputBrush}"
                                BorderBrush="{StaticResource BorderHairlineBrush}"
                                BorderThickness="1"
                                CornerRadius="6"
                                Padding="10,4"
                                VerticalAlignment="Center"
                                Margin="0,0,10,0">
                            <Viewbox StretchDirection="DownOnly">
                                <TextBlock Text="{Binding WallboardClockText}"
                                           Style="{StaticResource TabularTextStyle}"
                                           FontSize="18"
                                           FontWeight="Bold"
                                           Foreground="{StaticResource AccentCyanBrush}"/>
                            </Viewbox>
                        </Border>

                        <!-- Machine Pills & Camera Health Pills (2 horizontal strips inside DownOnly Viewbox to keep top bar single-row) -->
                        <Viewbox Grid.Column="2"
                                 StretchDirection="DownOnly"
                                 HorizontalAlignment="Center"
                                 VerticalAlignment="Center"
                                 Margin="0,0,8,0">
                            <StackPanel Orientation="Vertical">
                                <ItemsControl ItemsSource="{Binding MachineRows}"
                                              HorizontalAlignment="Center"
                                              Margin="0,0,0,3">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Orientation="Horizontal"/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="{Binding BgColor, Converter={StaticResource HexToFrozenBrushConverter}}"
                                                    BorderBrush="{Binding Color, Converter={StaticResource HexToFrozenBrushConverter}}"
                                                    BorderThickness="1"
                                                    CornerRadius="6"
                                                    Padding="7,2"
                                                    Margin="0,0,4,0">
                                                <TextBlock Text="{Binding Name}"
                                                           Foreground="{Binding Color, Converter={StaticResource HexToFrozenBrushConverter}}"
                                                           FontSize="11"
                                                           FontWeight="Bold"/>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <ItemsControl ItemsSource="{Binding CameraHealthItems}"
                                              HorizontalAlignment="Center">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Orientation="Horizontal"/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border BorderBrush="{StaticResource BorderHairlineBrush}"
                                                    BorderThickness="1"
                                                    CornerRadius="6"
                                                    Padding="6,2"
                                                    Margin="0,0,4,0"
                                                    ToolTip="{Binding ToolTip}">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Background" Value="{StaticResource CameraOfflineBgBrush}"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Online}" Value="True">
                                                                <Setter Property="Background" Value="{StaticResource CameraOnlineBgBrush}"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                    <Ellipse Width="7" Height="7" Margin="0,0,5,0" VerticalAlignment="Center">
                                                        <Ellipse.Style>
                                                            <Style TargetType="Ellipse">
                                                                <Setter Property="Fill" Value="{StaticResource CameraOfflineBrush}"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding Online}" Value="True">
                                                                        <Setter Property="Fill" Value="{StaticResource CameraOnlineDotBrush}"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Ellipse.Style>
                                                    </Ellipse>
                                                    <TextBlock Text="{Binding Label}"
                                                               FontSize="11"
                                                               FontWeight="Bold">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock" BasedOn="{StaticResource TabularTextStyle}">
                                                                <Setter Property="Foreground" Value="{StaticResource CameraOfflineBrush}"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding Online}" Value="True">
                                                                        <Setter Property="Foreground" Value="{StaticResource CameraOnlineTextBrush}"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Viewbox>

                        <!-- Auto-Rotate & Exit Wallboard Controls -->
                        <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Command="{Binding ToggleAutoRotateCommand}"
                                    Style="{StaticResource AccentOutlineButtonStyle}"
                                    Padding="9,6"
                                    FontSize="12"
                                    Margin="0,0,6,0">
                                <StackPanel Orientation="Horizontal" IsHitTestVisible="False">
                                    <Path Width="13" Height="13" Stretch="Uniform"
                                          Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                          VerticalAlignment="Center"
                                          Margin="0,0,5,0">
                                        <Path.Style>
                                            <Style TargetType="Path">
                                                <Setter Property="Data" Value="{StaticResource IconRefreshGeometry}"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsAutoRotateActive}" Value="False">
                                                        <Setter Property="Data" Value="{StaticResource IconPauseGeometry}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Path.Style>
                                    </Path>
                                    <TextBlock Text="{Binding AutoRotateButtonText}" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <Button Command="{Binding CycleAutoRotateIntervalCommand}"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    Padding="9,6"
                                    FontSize="12"
                                    Margin="0,0,6,0"
                                    ToolTip="{DynamicResource Wall_IntervalTooltip}">
                                <StackPanel Orientation="Horizontal" IsHitTestVisible="False">
                                    <Path Data="{StaticResource IconClockGeometry}"
                                          Style="{StaticResource VectorIconPathStyle}"
                                          Width="13" Height="13"
                                          Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                          Margin="0,0,5,0"/>
                                    <TextBlock Text="{DynamicResource Wall_IntervalBtn}" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <Button Command="{Binding NextCarouselSlideCommand}"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    Padding="9,6"
                                    FontSize="12"
                                    Margin="0,0,6,0"
                                    ToolTip="{DynamicResource Wall_NextViewTooltip}">
                                <StackPanel Orientation="Horizontal" IsHitTestVisible="False">
                                    <Path Data="{StaticResource IconNextGeometry}"
                                          Style="{StaticResource VectorIconPathStyle}"
                                          Width="13" Height="13"
                                          Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                          Margin="0,0,5,0"/>
                                    <TextBlock Text="{DynamicResource Wall_NextViewBtn}" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <Button Command="{Binding ToggleKioskCommand}"
                                    Style="{StaticResource DangerButtonStyle}"
                                    Padding="9,6"
                                    FontSize="12"
                                    FontWeight="Bold">
                                <StackPanel Orientation="Horizontal" IsHitTestVisible="False">
                                    <Path Data="{StaticResource IconCloseGeometry}"
                                          Style="{StaticResource VectorIconPathStyle}"
                                          Width="13" Height="13"
                                          Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                          Margin="0,0,5,0"/>
                                    <TextBlock Text="{DynamicResource Wall_ExitBtn}" VerticalAlignment="Center"/>
                                    <Border Style="{StaticResource KbdBadgeBorderStyle}">
                                        <TextBlock Text="F11" Style="{StaticResource KbdBadgeTextStyle}" FontSize="10"/>
                                    </Border>
                                    <Border Style="{StaticResource KbdBadgeBorderStyle}" Margin="4,0,0,0">
                                        <TextBlock Text="ESC" Style="{StaticResource KbdBadgeTextStyle}" FontSize="10"/>
                                    </Border>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- ROW 1: 5 Oversized KPI Hero Cards (5-10m Viewing Distance, Tabular Numerals) -->
                <Grid Grid.Row="1" Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.15*"/>
                        <ColumnDefinition Width="1*"/>
                        <ColumnDefinition Width="1*"/>
                        <ColumnDefinition Width="1.2*"/>
                        <ColumnDefinition Width="1.65*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Hero Card 1: TOTAL TESTED & SHIFT TARGET GAUGE -->
                    <Border Grid.Column="0"
                            Background="{StaticResource SurfaceCardBrush}"
                            BorderBrush="{StaticResource AccentBrush}"
                            BorderThickness="2"
                            CornerRadius="8"
                            Padding="14,10"
                            Margin="0,0,8,0">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Viewbox Grid.Row="0" StretchDirection="DownOnly" HorizontalAlignment="Left">
                                <TextBlock Text="{DynamicResource Wall_TotalTested}"
                                           FontSize="14"
                                           FontWeight="Bold"
                                           Foreground="{StaticResource TextSecondaryBrush}"/>
                            </Viewbox>
                            <Viewbox Grid.Row="1" StretchDirection="DownOnly" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="0,4">
                                <TextBlock Text="{Binding TotalTested}"
                                           Style="{StaticResource TabularTextStyle}"
                                           FontSize="54"
                                           FontWeight="Bold"
                                           Foreground="{StaticResource AccentCyanBrush}"/>
                            </Viewbox>
                            <StackPanel Grid.Row="2" Margin="0,4,0,0">
                                <TextBlock Text="{Binding ShiftTargetText}"
                                           Style="{StaticResource TabularTextStyle}"
                                           FontSize="12"
                                           FontWeight="SemiBold"
                                           Foreground="{StaticResource TextSecondaryBrush}"
                                           TextTrimming="CharacterEllipsis"
                                           Margin="0,0,0,4"/>
                                <ProgressBar Minimum="0"
                                             Maximum="100"
                                             Value="{Binding ShiftProgressPercent, Mode=OneWay}"
                                             Height="8"
                                             Background="{StaticResource SurfaceInputBrush}"
                                             Foreground="{StaticResource AccentBrush}"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Hero Card 2: PASS (OK) -->
                    <Border Grid.Column="1"
                            Background="{StaticResource SurfaceCardBrush}"
                            BorderBrush="{StaticResource PassBrush}"
                            BorderThickness="2"
                            CornerRadius="8"
                            Padding="14,10"
                            Margin="0,0,8,0">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Viewbox Grid.Row="0" StretchDirection="DownOnly" HorizontalAlignment="Left">
                                <TextBlock Text="{DynamicResource Kpi_PassOk}"
                                           FontSize="14"
                                           FontWeight="Bold"
                                           Foreground="{StaticResource PassTextBrush}"/>
                            </Viewbox>
                            <Viewbox Grid.Row="1" StretchDirection="DownOnly" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="0,4">
                                <TextBlock Text="{Binding TotalOk}"
                                           Style="{StaticResource TabularTextStyle}"
                                           FontSize="54"
                                           FontWeight="Bold"
                                           Foreground="{StaticResource PassTextBrush}"/>
                            </Viewbox>
                            <TextBlock Grid.Row="2"
                                       Text="{DynamicResource Kpi_WithinSpec}"
                                       FontSize="12"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource PassTextBrush}"
                                       TextTrimming="CharacterEllipsis"/>
                        </Grid>
                    </Border>

                    <!-- Hero Card 3: FAIL (NG) -->
                    <Border Grid.Column="2"
                            Background="{StaticResource SurfaceCardBrush}"
                            BorderBrush="{StaticResource FailBrush}"
                            BorderThickness="2"
                            CornerRadius="8"
                            Padding="14,10"
                            Margin="0,0,8,0">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Viewbox Grid.Row="0" StretchDirection="DownOnly" HorizontalAlignment="Left">
                                <TextBlock Text="{DynamicResource Kpi_FailNg}"
                                           FontSize="14"
                                           FontWeight="Bold"
                                           Foreground="{StaticResource FailTextBrush}"/>
                            </Viewbox>
                            <Viewbox Grid.Row="1" StretchDirection="DownOnly" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="0,4">
                                <TextBlock Text="{Binding TotalNg}"
                                           Style="{StaticResource TabularTextStyle}"
                                           FontSize="54"
                                           FontWeight="Bold"
                                           Foreground="{StaticResource FailTextBrush}"/>
                            </Viewbox>
                            <TextBlock Grid.Row="2"
                                       Text="{Binding DefectRateText}"
                                       Style="{StaticResource TabularTextStyle}"
                                       FontSize="13"
                                       FontWeight="Bold"
                                       Foreground="{StaticResource FailTextBrush}"
                                       TextTrimming="CharacterEllipsis"/>
                        </Grid>
                    </Border>

                    <!-- Hero Card 4: FIRST PASS YIELD (FPY %) & DEFECT RATE -->
                    <Border Grid.Column="3"
                            Background="{Binding KpiHeroRateBg, Converter={StaticResource HexToFrozenBrushConverter}}"
                            BorderBrush="{Binding KpiHeroRateBorder}"
                            BorderThickness="2"
                            CornerRadius="8"
                            Padding="14,10"
                            Margin="0,0,8,0">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Grid Grid.Row="0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Viewbox Grid.Column="0"
                                         StretchDirection="DownOnly"
                                         HorizontalAlignment="Left"
                                         VerticalAlignment="Center"
                                         Margin="0,0,6,0">
                                    <TextBlock Text="{DynamicResource Wall_FpyTitle}"
                                               FontSize="14"
                                               FontWeight="Bold"
                                               Foreground="{StaticResource TextPrimaryBrush}"/>
                                </Viewbox>
                                <Border Grid.Column="1"
                                        Background="{StaticResource BgPrimaryBrush}"
                                        BorderBrush="{Binding KpiHeroRateBorder}"
                                        BorderThickness="1"
                                        CornerRadius="4"
                                        Padding="8,2"
                                        VerticalAlignment="Center">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Opacity" Value="1"/>
                                            <Style.Triggers>
                                                <MultiDataTrigger>
                                                    <MultiDataTrigger.Conditions>
                                                        <Condition Binding="{Binding IsCriticalAlarmFlashing}" Value="True"/>
                                                        <Condition Binding="{Binding IsKioskMode}" Value="True"/>
                                                        <Condition Binding="{Binding IsVisible, RelativeSource={RelativeSource Self}}" Value="True"/>
                                                    </MultiDataTrigger.Conditions>
                                                    <MultiDataTrigger.EnterActions>
                                                        <BeginStoryboard x:Name="CriticalAlarmPulseStoryboard">
                                                            <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                                                                <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                                                 From="1.0" To="0.3" Duration="0:0:0.45"/>
                                                            </Storyboard>
                                                        </BeginStoryboard>
                                                    </MultiDataTrigger.EnterActions>
                                                    <MultiDataTrigger.ExitActions>
                                                        <StopStoryboard BeginStoryboardName="CriticalAlarmPulseStoryboard"/>
                                                    </MultiDataTrigger.ExitActions>
                                                </MultiDataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <TextBlock Text="{Binding KpiAlertLevel}"
                                               FontSize="11"
                                               FontWeight="Bold"
                                               Foreground="{Binding KpiHeroRateFg, Converter={StaticResource HexToFrozenBrushConverter}}"/>
                                </Border>
                            </Grid>
                            <Viewbox Grid.Row="1" StretchDirection="DownOnly" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="0,4">
                                <TextBlock Text="{Binding FpyRateText}"
                                           Style="{StaticResource TabularTextStyle}"
                                           FontSize="54"
                                           FontWeight="Bold"
                                           Foreground="{Binding KpiHeroRateFg, Converter={StaticResource HexToFrozenBrushConverter}}"/>
                            </Viewbox>
                            <TextBlock Grid.Row="2"
                                       Text="{Binding DefectRateText}"
                                       Style="{StaticResource TabularTextStyle}"
                                       FontSize="13"
                                       FontWeight="Bold"
                                       Foreground="{StaticResource TextPrimaryBrush}"
                                       TextTrimming="CharacterEllipsis"/>
                        </Grid>
                    </Border>

                    <!-- Hero Card 5: OTP DEFECT BREAKDOWN -->
                    <Border Grid.Column="4"
                            Background="{StaticResource SurfaceCardBrush}"
                            BorderBrush="{StaticResource BorderHairlineBrush}"
                            BorderThickness="2"
                            CornerRadius="8"
                            Padding="14,10">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <Viewbox Grid.Row="0" StretchDirection="DownOnly" HorizontalAlignment="Left" Margin="0,0,0,8">
                                <TextBlock Text="{DynamicResource Wall_DefectBreakdown}"
                                           FontSize="14"
                                           FontWeight="Bold"
                                           Foreground="{StaticResource TextSecondaryBrush}"/>
                            </Viewbox>
                            <UniformGrid Grid.Row="1" Columns="4">
                                <Border Background="{StaticResource SurfaceInputBrush}"
                                        BorderBrush="{StaticResource BorderHairlineBrush}"
                                        BorderThickness="1"
                                        CornerRadius="6"
                                        Padding="7,4"
                                        Margin="0,0,6,0">
                                    <StackPanel>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <Viewbox Grid.Column="0" StretchDirection="DownOnly" HorizontalAlignment="Left" Margin="0,0,4,0">
                                                <TextBlock Text="XYLV" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextSecondaryBrush}"/>
                                            </Viewbox>
                                            <TextBlock Grid.Column="1"
                                                       Text="{Binding XylvShareText}"
                                                       Style="{StaticResource TabularTextStyle}"
                                                       FontSize="11"
                                                       FontWeight="Bold"
                                                       Foreground="{StaticResource FailTextBrush}"
                                                       VerticalAlignment="Center"/>
                                        </Grid>
                                        <Viewbox StretchDirection="DownOnly" HorizontalAlignment="Left" Margin="0,3,0,4">
                                            <TextBlock Text="{Binding CountXylv}"
                                                       Style="{StaticResource TabularTextStyle}"
                                                       FontSize="28"
                                                       FontWeight="Bold"
                                                       Foreground="{StaticResource FailTextBrush}"/>
                                        </Viewbox>
                                        <Border Height="4" CornerRadius="2" Background="{StaticResource SurfaceElevatedBrush}" ClipToBounds="True">
                                            <Border CornerRadius="2" Background="{StaticResource FailBrush}" RenderTransformOrigin="0,0.5">
                                                <Border.RenderTransform>
                                                    <ScaleTransform ScaleX="{Binding XylvShareRatio}" ScaleY="1"/>
                                                </Border.RenderTransform>
                                            </Border>
                                        </Border>
                                    </StackPanel>
                                </Border>
                                <Border Background="{StaticResource SurfaceInputBrush}"
                                        BorderBrush="{StaticResource BorderHairlineBrush}"
                                        BorderThickness="1"
                                        CornerRadius="6"
                                        Padding="7,4"
                                        Margin="0,0,6,0">
                                    <StackPanel>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <Viewbox Grid.Column="0" StretchDirection="DownOnly" HorizontalAlignment="Left" Margin="0,0,4,0">
                                                <TextBlock Text="POWERON" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextSecondaryBrush}"/>
                                            </Viewbox>
                                            <TextBlock Grid.Column="1"
                                                       Text="{Binding PowerOnShareText}"
                                                       Style="{StaticResource TabularTextStyle}"
                                                       FontSize="11"
                                                       FontWeight="Bold"
                                                       Foreground="{StaticResource WarningTextBrush}"
                                                       VerticalAlignment="Center"/>
                                        </Grid>
                                        <Viewbox StretchDirection="DownOnly" HorizontalAlignment="Left" Margin="0,3,0,4">
                                            <TextBlock Text="{Binding CountPowerOn}"
                                                       Style="{StaticResource TabularTextStyle}"
                                                       FontSize="28"
                                                       FontWeight="Bold"
                                                       Foreground="{StaticResource WarningTextBrush}"/>
                                        </Viewbox>
                                        <Border Height="4" CornerRadius="2" Background="{StaticResource SurfaceElevatedBrush}" ClipToBounds="True">
                                            <Border CornerRadius="2" Background="{StaticResource WarningTextBrush}" RenderTransformOrigin="0,0.5">
                                                <Border.RenderTransform>
                                                    <ScaleTransform ScaleX="{Binding PowerOnShareRatio}" ScaleY="1"/>
                                                </Border.RenderTransform>
                                            </Border>
                                        </Border>
                                    </StackPanel>
                                </Border>
                                <Border Background="{StaticResource SurfaceInputBrush}"
                                        BorderBrush="{StaticResource BorderHairlineBrush}"
                                        BorderThickness="1"
                                        CornerRadius="6"
                                        Padding="7,4"
                                        Margin="0,0,6,0">
                                    <StackPanel>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <Viewbox Grid.Column="0" StretchDirection="DownOnly" HorizontalAlignment="Left" Margin="0,0,4,0">
                                                <TextBlock Text="POWEROFF" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextSecondaryBrush}"/>
                                            </Viewbox>
                                            <TextBlock Grid.Column="1"
                                                       Text="{Binding PowerOffShareText}"
                                                       Style="{StaticResource TabularTextStyle}"
                                                       FontSize="11"
                                                       FontWeight="Bold"
                                                       Foreground="{StaticResource PowerOffAccentBrush}"
                                                       VerticalAlignment="Center"/>
                                        </Grid>
                                        <Viewbox StretchDirection="DownOnly" HorizontalAlignment="Left" Margin="0,3,0,4">
                                            <TextBlock Text="{Binding CountPowerOff}"
                                                       Style="{StaticResource TabularTextStyle}"
                                                       FontSize="28"
                                                       FontWeight="Bold"
                                                       Foreground="{StaticResource PowerOffAccentBrush}"/>
                                        </Viewbox>
                                        <Border Height="4" CornerRadius="2" Background="{StaticResource SurfaceElevatedBrush}" ClipToBounds="True">
                                            <Border CornerRadius="2" Background="{StaticResource PowerOffAccentBrush}" RenderTransformOrigin="0,0.5">
                                                <Border.RenderTransform>
                                                    <ScaleTransform ScaleX="{Binding PowerOffShareRatio}" ScaleY="1"/>
                                                </Border.RenderTransform>
                                            </Border>
                                        </Border>
                                    </StackPanel>
                                </Border>
                                <Border Background="{StaticResource SurfaceInputBrush}"
                                        BorderBrush="{StaticResource BorderHairlineBrush}"
                                        BorderThickness="1"
                                        CornerRadius="6"
                                        Padding="7,4">
                                    <StackPanel>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <Viewbox Grid.Column="0" StretchDirection="DownOnly" HorizontalAlignment="Left" Margin="0,0,4,0">
                                                <TextBlock Text="FLICKER" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextSecondaryBrush}"/>
                                            </Viewbox>
                                            <TextBlock Grid.Column="1"
                                                       Text="{Binding FlickerShareText}"
                                                       Style="{StaticResource TabularTextStyle}"
                                                       FontSize="11"
                                                       FontWeight="Bold"
                                                       Foreground="{StaticResource AccentCyanBrush}"
                                                       VerticalAlignment="Center"/>
                                        </Grid>
                                        <Viewbox StretchDirection="DownOnly" HorizontalAlignment="Left" Margin="0,3,0,4">
                                            <TextBlock Text="{Binding CountFlicker}"
                                                       Style="{StaticResource TabularTextStyle}"
                                                       FontSize="28"
                                                       FontWeight="Bold"
                                                       Foreground="{StaticResource AccentCyanBrush}"/>
                                        </Viewbox>
                                        <Border Height="4" CornerRadius="2" Background="{StaticResource SurfaceElevatedBrush}" ClipToBounds="True">
                                            <Border CornerRadius="2" Background="{StaticResource AccentCyanBrush}" RenderTransformOrigin="0,0.5">
                                                <Border.RenderTransform>
                                                    <ScaleTransform ScaleX="{Binding FlickerShareRatio}" ScaleY="1"/>
                                                </Border.RenderTransform>
                                            </Border>
                                        </Border>
                                    </StackPanel>
                                </Border>
                            </UniformGrid>
                        </Grid>
                    </Border>
                </Grid>

                <!-- ROW 2: Consecutive NG / Defect Alert Banner (10m Readable) -->
                <Border Grid.Row="2"
                        Background="{Binding AlertBackground, Converter={StaticResource HexToFrozenBrushConverter}}"
                        BorderBrush="{Binding AlertBorderBrush, Converter={StaticResource HexToFrozenBrushConverter}}"
                        BorderThickness="2"
                        CornerRadius="10"
                        Padding="16,10"
                        Margin="0,0,0,12"
                        Visibility="{Binding IsAlertVisible, Converter={StaticResource BoolToVis}}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0"
                                   Text="{Binding AlertTitle}"
                                   FontSize="20"
                                   FontWeight="Bold"
                                   Foreground="{Binding AlertTitleColor, Converter={StaticResource HexToFrozenBrushConverter}}"
                                   Margin="0,0,16,0"
                                   VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="1"
                                   Text="{Binding AlertMessage}"
                                   Style="{StaticResource TabularTextStyle}"
                                   FontSize="20"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource TextPrimaryBrush}"
                                   VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis"/>
                        <Button Grid.Column="2"
                                Style="{StaticResource DangerButtonStyle}"
                                Command="{Binding DismissAlertCommand}"
                                Padding="12,5"
                                FontSize="14"
                                FontWeight="Bold">
                            <StackPanel Orientation="Horizontal" IsHitTestVisible="False">
                                <Path Data="{StaticResource IconCloseGeometry}"
                                      Style="{StaticResource VectorIconPathStyle}"
                                      Width="12" Height="12"
                                      Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                      Margin="0,0,6,0"/>
                                <TextBlock Text="{DynamicResource Alert_DismissBtn}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </Grid>
                </Border>

                <!-- ROW 3: 2-Column Shop-Floor Split (62% Left Carousel / 38% Right Live NG Spotlight) -->
                <Grid Grid.Row="3">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="62*"/>
                        <ColumnDefinition Width="38*"/>
                    </Grid.ColumnDefinitions>

                    <!-- LEFT COLUMN (62%): Auto-Carousel Analytics Viewport -->
                    <Border Grid.Column="0"
                            Background="{StaticResource SurfaceCardBrush}"
                            BorderBrush="{StaticResource BorderHairlineBrush}"
                            BorderThickness="1"
                            CornerRadius="10"
                            Padding="14"
                            Margin="0,0,12,0">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <!-- Carousel Header Bar, Slide Indicator Dots & Slide Selector Buttons -->
                            <Grid Grid.Row="0" Margin="0,0,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Viewbox Grid.Column="0"
                                         StretchDirection="DownOnly"
                                         HorizontalAlignment="Left"
                                         VerticalAlignment="Center"
                                         Margin="0,0,10,0">
                                    <TextBlock Text="{Binding WallboardCarouselTitle}"
                                               FontSize="19"
                                               FontWeight="Bold"
                                               Foreground="{StaticResource AccentCyanBrush}"/>
                                </Viewbox>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                    <!-- 4 Interactive Slide Indicator Dots -->
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,8,0">
                                        <Button Command="{Binding SelectCarouselSlideCommand}" CommandParameter="0"
                                                Style="{StaticResource GhostButtonStyle}" Padding="3,4" ToolTip="{DynamicResource Wall_Slide1Tooltip}">
                                            <Border Width="14" Height="8" CornerRadius="4" Background="{StaticResource AccentCyanBrush}">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Opacity" Value="0.28"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding WallboardCarouselIndex}" Value="0">
                                                                <Setter Property="Opacity" Value="1.0"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                            </Border>
                                        </Button>
                                        <Button Command="{Binding SelectCarouselSlideCommand}" CommandParameter="1"
                                                Style="{StaticResource GhostButtonStyle}" Padding="3,4" ToolTip="{DynamicResource Wall_Slide2Tooltip}">
                                            <Border Width="14" Height="8" CornerRadius="4" Background="{StaticResource AccentCyanBrush}">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Opacity" Value="0.28"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding WallboardCarouselIndex}" Value="1">
                                                                <Setter Property="Opacity" Value="1.0"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                            </Border>
                                        </Button>
                                        <Button Command="{Binding SelectCarouselSlideCommand}" CommandParameter="2"
                                                Style="{StaticResource GhostButtonStyle}" Padding="3,4" ToolTip="{DynamicResource Wall_Slide3Tooltip}">
                                            <Border Width="14" Height="8" CornerRadius="4" Background="{StaticResource AccentCyanBrush}">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Opacity" Value="0.28"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding WallboardCarouselIndex}" Value="2">
                                                                <Setter Property="Opacity" Value="1.0"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                            </Border>
                                        </Button>
                                        <Button Command="{Binding SelectCarouselSlideCommand}" CommandParameter="3"
                                                Style="{StaticResource GhostButtonStyle}" Padding="3,4" ToolTip="{DynamicResource Wall_Slide4Tooltip}">
                                            <Border Width="14" Height="8" CornerRadius="4" Background="{StaticResource AccentCyanBrush}">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Opacity" Value="0.28"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding WallboardCarouselIndex}" Value="3">
                                                                <Setter Property="Opacity" Value="1.0"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                            </Border>
                                        </Button>
                                    </StackPanel>

                                    <Border Background="{StaticResource SurfaceInputBrush}"
                                            BorderBrush="{StaticResource BorderHairlineBrush}"
                                            BorderThickness="1"
                                            CornerRadius="6"
                                            Padding="2"
                                            VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal">
                                            <Button Content="{DynamicResource Wall_Slide1Btn}"
                                                    Command="{Binding SelectCarouselSlideCommand}"
                                                    CommandParameter="0"
                                                    Padding="10,4"
                                                    FontSize="12"
                                                    Margin="0,0,2,0">
                                                <Button.Style>
                                                    <Style TargetType="Button" BasedOn="{StaticResource SegmentedItemButtonStyle}">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding WallboardCarouselIndex}" Value="0">
                                                                <Setter Property="Background" Value="{StaticResource AccentTintBrush}"/>
                                                                <Setter Property="BorderBrush" Value="{StaticResource AccentBorderBrush}"/>
                                                                <Setter Property="Foreground" Value="{StaticResource AccentCyanBrush}"/>
                                                                <Setter Property="FontWeight" Value="Bold"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Button.Style>
                                            </Button>
                                            <Button Content="{DynamicResource Wall_Slide2Btn}"
                                                    Command="{Binding SelectCarouselSlideCommand}"
                                                    CommandParameter="1"
                                                    Padding="10,4"
                                                    FontSize="12"
                                                    Margin="0,0,2,0">
                                                <Button.Style>
                                                    <Style TargetType="Button" BasedOn="{StaticResource SegmentedItemButtonStyle}">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding WallboardCarouselIndex}" Value="1">
                                                                <Setter Property="Background" Value="{StaticResource AccentTintBrush}"/>
                                                                <Setter Property="BorderBrush" Value="{StaticResource AccentBorderBrush}"/>
                                                                <Setter Property="Foreground" Value="{StaticResource AccentCyanBrush}"/>
                                                                <Setter Property="FontWeight" Value="Bold"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Button.Style>
                                            </Button>
                                            <Button Content="{DynamicResource Wall_Slide3Btn}"
                                                    Command="{Binding SelectCarouselSlideCommand}"
                                                    CommandParameter="2"
                                                    Padding="10,4"
                                                    FontSize="12"
                                                    Margin="0,0,2,0">
                                                <Button.Style>
                                                    <Style TargetType="Button" BasedOn="{StaticResource SegmentedItemButtonStyle}">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding WallboardCarouselIndex}" Value="2">
                                                                <Setter Property="Background" Value="{StaticResource AccentTintBrush}"/>
                                                                <Setter Property="BorderBrush" Value="{StaticResource AccentBorderBrush}"/>
                                                                <Setter Property="Foreground" Value="{StaticResource AccentCyanBrush}"/>
                                                                <Setter Property="FontWeight" Value="Bold"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Button.Style>
                                            </Button>
                                            <Button Content="{DynamicResource Wall_Slide4Btn}"
                                                    Command="{Binding SelectCarouselSlideCommand}"
                                                    CommandParameter="3"
                                                    Padding="10,4"
                                                    FontSize="12">
                                                <Button.Style>
                                                    <Style TargetType="Button" BasedOn="{StaticResource SegmentedItemButtonStyle}">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding WallboardCarouselIndex}" Value="3">
                                                                <Setter Property="Background" Value="{StaticResource AccentTintBrush}"/>
                                                                <Setter Property="BorderBrush" Value="{StaticResource AccentBorderBrush}"/>
                                                                <Setter Property="Foreground" Value="{StaticResource AccentCyanBrush}"/>
                                                                <Setter Property="FontWeight" Value="Bold"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Button.Style>
                                            </Button>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </Grid>

                            <!-- Thin GPU-Accelerated Carousel Progress Bar (ScaleTransform.ScaleX, 0% Layout Pass) -->
                            <Border Grid.Row="1"
                                    Height="3"
                                    CornerRadius="1.5"
                                    Background="{StaticResource SurfaceInputBrush}"
                                    ClipToBounds="True"
                                    Margin="0,0,0,8">
                                <Border CornerRadius="1.5"
                                        Background="{StaticResource AccentCyanBrush}"
                                        RenderTransformOrigin="0,0.5">
                                    <Border.RenderTransform>
                                        <ScaleTransform ScaleX="{Binding WallboardCarouselProgress}" ScaleY="1"/>
                                    </Border.RenderTransform>
                                </Border>
                            </Border>

                            <!-- Slide 0..2: High-Contrast Wallboard Vector Chart Canvas -->
                            <Border Grid.Row="2"
                                    Background="{StaticResource BgPrimaryBrush}"
                                    BorderBrush="{StaticResource BorderHairlineBrush}"
                                    BorderThickness="1"
                                    CornerRadius="8"
                                    ClipToBounds="True"
                                    Visibility="{Binding IsWallboardChartSlide, Converter={StaticResource BoolToVis}}">
                                <Grid ClipToBounds="True">
                                    <Canvas x:Name="cvWallboardChart" Background="{StaticResource CanvasHitTestBrush}"/>
                                    <TextBlock Text="{DynamicResource Wall_NoDataScope}"
                                               FontSize="20"
                                               FontWeight="SemiBold"
                                               Foreground="{StaticResource TextSecondaryBrush}"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"
                                               IsHitTestVisible="False"
                                               Visibility="{Binding Chart.IsChartEmpty, Converter={StaticResource BoolToVis}}"/>
                                </Grid>
                            </Border>

                            <!-- Slide 3: Faulty PMNT-A, PMNT-B & Other High-Visibility Ranking Tables -->
                            <Grid Grid.Row="2" Visibility="{Binding IsWallboardPmntSlide, Converter={StaticResource BoolToVis}}">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto" MaxHeight="205"/>
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="1*"/>
                                    <ColumnDefinition Width="1*"/>
                                </Grid.ColumnDefinitions>

                                <!-- Wallboard PMNT-A Table -->
                                <Border Grid.Column="0"
                                        Background="{StaticResource SurfaceInputBrush}"
                                        BorderBrush="{StaticResource AccentBrush}"
                                        BorderThickness="1"
                                        CornerRadius="8"
                                        Padding="10"
                                        Margin="0,0,6,0">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="*"/>
                                        </Grid.RowDefinitions>
                                        <DockPanel Grid.Row="0" Margin="0,0,0,8">
                                            <TextBlock Text="{DynamicResource Wall_PmntARanking}"
                                                       FontSize="16"
                                                       FontWeight="Bold"
                                                       Foreground="{StaticResource AccentCyanBrush}"/>
                                            <TextBlock Text="{Binding PmntACountText}"
                                                       Style="{StaticResource TabularTextStyle}"
                                                       FontSize="14"
                                                       Foreground="{StaticResource TextSecondaryBrush}"
                                                       HorizontalAlignment="Right"/>
                                        </DockPanel>
                                        <DataGrid Grid.Row="1"
                                                  ItemsSource="{Binding PmntAList}"
                                                  RowStyle="{StaticResource PmntAlarmDataGridRowStyle}"
                                                  FontSize="16"
                                                  RowHeight="38"
                                                  EnableRowVirtualization="True"
                                                  EnableColumnVirtualization="True"
                                                  VirtualizingPanel.IsVirtualizing="True"
                                                  VirtualizingPanel.VirtualizationMode="Recycling"
                                                  VirtualizingPanel.ScrollUnit="Pixel"
                                                  VirtualizingPanel.CacheLength="2,2"
                                                  VirtualizingPanel.CacheLengthUnit="Page">
                                            <DataGrid.Columns>
                                                <DataGridTextColumn Binding="{Binding Name}" Width="1.2*" ElementStyle="{StaticResource TabularDataGridTextStyle}">
                                                    <DataGridTextColumn.Header>
                                                        <TextBlock Text="{DynamicResource Col_PmntCode}"
                                                                   TextTrimming="CharacterEllipsis"
                                                                   ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
                                                    </DataGridTextColumn.Header>
                                                </DataGridTextColumn>
                                                <DataGridTemplateColumn Width="1.2*" SortMemberPath="Count" ClipboardContentBinding="{Binding Count}">
                                                    <DataGridTemplateColumn.Header>
                                                        <TextBlock Text="{DynamicResource Wall_ColDefects}"
                                                                   TextTrimming="CharacterEllipsis"
                                                                   ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
                                                    </DataGridTemplateColumn.Header>
                                                    <DataGridTemplateColumn.CellTemplate>
                                                        <DataTemplate>
                                                            <Grid Margin="2,4" ClipToBounds="True">
                                                                <Border Style="{StaticResource GpuDataBarTrackStyle}"
                                                                        Background="{StaticResource DataBarTrackABrush}">
                                                                    <Border.RenderTransform>
                                                                        <ScaleTransform ScaleX="{Binding CountRatio, Mode=OneWay}" ScaleY="1"/>
                                                                    </Border.RenderTransform>
                                                                </Border>
                                                                <DockPanel VerticalAlignment="Center" Margin="8,0">
                                                                    <TextBlock Text="{Binding Count}"
                                                                               Style="{StaticResource TabularTextStyle}"
                                                                               FontSize="15"
                                                                               FontWeight="Bold"
                                                                               VerticalAlignment="Center"/>
                                                                    <TextBlock Text="{Binding CountPercent, StringFormat={}{0:F0}%}"
                                                                               Style="{StaticResource TabularTextStyle}"
                                                                               FontSize="13"
                                                                               Foreground="{StaticResource TextSecondaryBrush}"
                                                                               HorizontalAlignment="Right"
                                                                               VerticalAlignment="Center"/>
                                                                </DockPanel>
                                                            </Grid>
                                                        </DataTemplate>
                                                    </DataGridTemplateColumn.CellTemplate>
                                                </DataGridTemplateColumn>
                                                <DataGridTemplateColumn Width="1*" SortMemberPath="Streak" ClipboardContentBinding="{Binding Streak}">
                                                    <DataGridTemplateColumn.Header>
                                                        <TextBlock Text="{DynamicResource Wall_ColCurStreak}"
                                                                   TextTrimming="CharacterEllipsis"
                                                                   ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
                                                    </DataGridTemplateColumn.Header>
                                                    <DataGridTemplateColumn.CellTemplate>
                                                        <DataTemplate>
                                                            <Border CornerRadius="6" Padding="10,2" HorizontalAlignment="Left" VerticalAlignment="Center" BorderThickness="1">
                                                                <Border.Style>
                                                                    <Style TargetType="Border">
                                                                        <Setter Property="Background" Value="Transparent"/>
                                                                        <Setter Property="BorderBrush" Value="Transparent"/>
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding IsAlarm}" Value="True">
                                                                                <Setter Property="Background" Value="{StaticResource FailTintBrush}"/>
                                                                                <Setter Property="BorderBrush" Value="{StaticResource FailBrush}"/>
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </Border.Style>
                                                                <TextBlock Text="{Binding Streak}" FontSize="15">
                                                                    <TextBlock.Style>
                                                                        <Style TargetType="TextBlock" BasedOn="{StaticResource TabularTextStyle}">
                                                                            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
                                                                            <Style.Triggers>
                                                                                <DataTrigger Binding="{Binding IsAlarm}" Value="True">
                                                                                    <Setter Property="Foreground" Value="{StaticResource FailTextBrush}"/>
                                                                                    <Setter Property="FontWeight" Value="Bold"/>
                                                                                </DataTrigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </TextBlock.Style>
                                                                </TextBlock>
                                                            </Border>
                                                        </DataTemplate>
                                                    </DataGridTemplateColumn.CellTemplate>
                                                </DataGridTemplateColumn>
                                                <DataGridTextColumn Binding="{Binding MaxStreak}" Width="1*" ElementStyle="{StaticResource TabularDataGridTextStyle}">
                                                    <DataGridTextColumn.Header>
                                                        <TextBlock Text="{DynamicResource Pmnt_ColMaxStreak}"
                                                                   TextTrimming="CharacterEllipsis"
                                                                   ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
                                                    </DataGridTextColumn.Header>
                                                </DataGridTextColumn>
                                            </DataGrid.Columns>
                                        </DataGrid>
                                    </Grid>
                                </Border>

                                <!-- Wallboard PMNT-B Table -->
                                <Border Grid.Column="1"
                                        Background="{StaticResource SurfaceInputBrush}"
                                        BorderBrush="{StaticResource FailBrush}"
                                        BorderThickness="1"
                                        CornerRadius="8"
                                        Padding="10"
                                        Margin="6,0,0,0">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="*"/>
                                        </Grid.RowDefinitions>
                                        <DockPanel Grid.Row="0" Margin="0,0,0,8">
                                            <TextBlock Text="{DynamicResource Wall_PmntBRanking}"
                                                       FontSize="16"
                                                       FontWeight="Bold"
                                                       Foreground="{StaticResource FailTextBrush}"/>
                                            <TextBlock Text="{Binding PmntBCountText}"
                                                       Style="{StaticResource TabularTextStyle}"
                                                       FontSize="14"
                                                       Foreground="{StaticResource TextSecondaryBrush}"
                                                       HorizontalAlignment="Right"/>
                                        </DockPanel>
                                        <DataGrid Grid.Row="1"
                                                  ItemsSource="{Binding PmntBList}"
                                                  RowStyle="{StaticResource PmntAlarmDataGridRowStyle}"
                                                  FontSize="16"
                                                  RowHeight="38"
                                                  EnableRowVirtualization="True"
                                                  EnableColumnVirtualization="True"
                                                  VirtualizingPanel.IsVirtualizing="True"
                                                  VirtualizingPanel.VirtualizationMode="Recycling"
                                                  VirtualizingPanel.ScrollUnit="Pixel"
                                                  VirtualizingPanel.CacheLength="2,2"
                                                  VirtualizingPanel.CacheLengthUnit="Page">
                                            <DataGrid.Columns>
                                                <DataGridTextColumn Binding="{Binding Name}" Width="1.2*" ElementStyle="{StaticResource TabularDataGridTextStyle}">
                                                    <DataGridTextColumn.Header>
                                                        <TextBlock Text="{DynamicResource Col_PmntCode}"
                                                                   TextTrimming="CharacterEllipsis"
                                                                   ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
                                                    </DataGridTextColumn.Header>
                                                </DataGridTextColumn>
                                                <DataGridTemplateColumn Width="1.2*" SortMemberPath="Count" ClipboardContentBinding="{Binding Count}">
                                                    <DataGridTemplateColumn.Header>
                                                        <TextBlock Text="{DynamicResource Wall_ColDefects}"
                                                                   TextTrimming="CharacterEllipsis"
                                                                   ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
                                                    </DataGridTemplateColumn.Header>
                                                    <DataGridTemplateColumn.CellTemplate>
                                                        <DataTemplate>
                                                            <Grid Margin="2,4" ClipToBounds="True">
                                                                <Border Style="{StaticResource GpuDataBarTrackStyle}"
                                                                        Background="{StaticResource DataBarTrackBBrush}">
                                                                    <Border.RenderTransform>
                                                                        <ScaleTransform ScaleX="{Binding CountRatio, Mode=OneWay}" ScaleY="1"/>
                                                                    </Border.RenderTransform>
                                                                </Border>
                                                                <DockPanel VerticalAlignment="Center" Margin="8,0">
                                                                    <TextBlock Text="{Binding Count}"
                                                                               Style="{StaticResource TabularTextStyle}"
                                                                               FontSize="15"
                                                                               FontWeight="Bold"
                                                                               VerticalAlignment="Center"/>
                                                                    <TextBlock Text="{Binding CountPercent, StringFormat={}{0:F0}%}"
                                                                               Style="{StaticResource TabularTextStyle}"
                                                                               FontSize="13"
                                                                               Foreground="{StaticResource TextSecondaryBrush}"
                                                                               HorizontalAlignment="Right"
                                                                               VerticalAlignment="Center"/>
                                                                </DockPanel>
                                                            </Grid>
                                                        </DataTemplate>
                                                    </DataGridTemplateColumn.CellTemplate>
                                                </DataGridTemplateColumn>
                                                <DataGridTemplateColumn Width="1*" SortMemberPath="Streak" ClipboardContentBinding="{Binding Streak}">
                                                    <DataGridTemplateColumn.Header>
                                                        <TextBlock Text="{DynamicResource Wall_ColCurStreak}"
                                                                   TextTrimming="CharacterEllipsis"
                                                                   ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
                                                    </DataGridTemplateColumn.Header>
                                                    <DataGridTemplateColumn.CellTemplate>
                                                        <DataTemplate>
                                                            <Border CornerRadius="6" Padding="10,2" HorizontalAlignment="Left" VerticalAlignment="Center" BorderThickness="1">
                                                                <Border.Style>
                                                                    <Style TargetType="Border">
                                                                        <Setter Property="Background" Value="Transparent"/>
                                                                        <Setter Property="BorderBrush" Value="Transparent"/>
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding IsAlarm}" Value="True">
                                                                                <Setter Property="Background" Value="{StaticResource FailTintBrush}"/>
                                                                                <Setter Property="BorderBrush" Value="{StaticResource FailBrush}"/>
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </Border.Style>
                                                                <TextBlock Text="{Binding Streak}" FontSize="15">
                                                                    <TextBlock.Style>
                                                                        <Style TargetType="TextBlock" BasedOn="{StaticResource TabularTextStyle}">
                                                                            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
                                                                            <Style.Triggers>
                                                                                <DataTrigger Binding="{Binding IsAlarm}" Value="True">
                                                                                    <Setter Property="Foreground" Value="{StaticResource FailTextBrush}"/>
                                                                                    <Setter Property="FontWeight" Value="Bold"/>
                                                                                </DataTrigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </TextBlock.Style>
                                                                </TextBlock>
                                                            </Border>
                                                        </DataTemplate>
                                                    </DataGridTemplateColumn.CellTemplate>
                                                </DataGridTemplateColumn>
                                                <DataGridTextColumn Binding="{Binding MaxStreak}" Width="1*" ElementStyle="{StaticResource TabularDataGridTextStyle}">
                                                    <DataGridTextColumn.Header>
                                                        <TextBlock Text="{DynamicResource Pmnt_ColMaxStreak}"
                                                                   TextTrimming="CharacterEllipsis"
                                                                   ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
                                                    </DataGridTextColumn.Header>
                                                </DataGridTextColumn>
                                            </DataGrid.Columns>
                                        </DataGrid>
                                    </Grid>
                                </Border>

                                <!-- Wallboard PMNT-Other Table (dynamic when unclassified PMNT defects exist) -->
                                <Border Grid.Row="1"
                                        Grid.ColumnSpan="2"
                                        Background="{StaticResource SurfaceInputBrush}"
                                        BorderBrush="{StaticResource WarningBrush}"
                                        BorderThickness="1"
                                        CornerRadius="8"
                                        Padding="10"
                                        Margin="0,10,0,0"
                                        Visibility="{Binding HasPmntOther, Converter={StaticResource BoolToVis}}">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="*"/>
                                        </Grid.RowDefinitions>
                                        <DockPanel Grid.Row="0" Margin="0,0,0,6">
                                            <TextBlock Text="{DynamicResource Wall_PmntOtherRanking}"
                                                       FontSize="15"
                                                       FontWeight="Bold"
                                                       Foreground="{StaticResource WarningTextBrush}"/>
                                            <TextBlock Text="{Binding PmntOtherCountText}"
                                                       Style="{StaticResource TabularTextStyle}"
                                                       FontSize="13"
                                                       Foreground="{StaticResource TextSecondaryBrush}"
                                                       HorizontalAlignment="Right"/>
                                        </DockPanel>
                                        <DataGrid Grid.Row="1"
                                                  ItemsSource="{Binding PmntOtherList}"
                                                  RowStyle="{StaticResource PmntAlarmDataGridRowStyle}"
                                                  FontSize="15"
                                                  RowHeight="34"
                                                  EnableRowVirtualization="True"
                                                  EnableColumnVirtualization="True"
                                                  VirtualizingPanel.IsVirtualizing="True"
                                                  VirtualizingPanel.VirtualizationMode="Recycling"
                                                  VirtualizingPanel.ScrollUnit="Pixel"
                                                  VirtualizingPanel.CacheLength="2,2"
                                                  VirtualizingPanel.CacheLengthUnit="Page">
                                            <DataGrid.Columns>
                                                <DataGridTextColumn Binding="{Binding Name}" Width="1.2*" ElementStyle="{StaticResource TabularDataGridTextStyle}">
                                                    <DataGridTextColumn.Header>
                                                        <TextBlock Text="{DynamicResource Col_PmntCode}"
                                                                   TextTrimming="CharacterEllipsis"
                                                                   ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
                                                    </DataGridTextColumn.Header>
                                                </DataGridTextColumn>
                                                <DataGridTemplateColumn Width="1.2*" SortMemberPath="Count" ClipboardContentBinding="{Binding Count}">
                                                    <DataGridTemplateColumn.Header>
                                                        <TextBlock Text="{DynamicResource Wall_ColDefects}"
                                                                   TextTrimming="CharacterEllipsis"
                                                                   ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
                                                    </DataGridTemplateColumn.Header>
                                                    <DataGridTemplateColumn.CellTemplate>
                                                        <DataTemplate>
                                                            <Grid Margin="2,4" ClipToBounds="True">
                                                                <Border Style="{StaticResource GpuDataBarTrackStyle}"
                                                                        Background="{StaticResource WarningTintBrush}">
                                                                    <Border.RenderTransform>
                                                                        <ScaleTransform ScaleX="{Binding CountRatio, Mode=OneWay}" ScaleY="1"/>
                                                                    </Border.RenderTransform>
                                                                </Border>
                                                                <DockPanel VerticalAlignment="Center" Margin="8,0">
                                                                    <TextBlock Text="{Binding Count}"
                                                                               Style="{StaticResource TabularTextStyle}"
                                                                               FontSize="14"
                                                                               FontWeight="Bold"
                                                                               VerticalAlignment="Center"/>
                                                                    <TextBlock Text="{Binding CountPercent, StringFormat={}{0:F0}%}"
                                                                               Style="{StaticResource TabularTextStyle}"
                                                                               FontSize="12"
                                                                               Foreground="{StaticResource TextSecondaryBrush}"
                                                                               HorizontalAlignment="Right"
                                                                               VerticalAlignment="Center"/>
                                                                </DockPanel>
                                                            </Grid>
                                                        </DataTemplate>
                                                    </DataGridTemplateColumn.CellTemplate>
                                                </DataGridTemplateColumn>
                                                <DataGridTemplateColumn Width="1*" SortMemberPath="Streak" ClipboardContentBinding="{Binding Streak}">
                                                    <DataGridTemplateColumn.Header>
                                                        <TextBlock Text="{DynamicResource Wall_ColCurStreak}"
                                                                   TextTrimming="CharacterEllipsis"
                                                                   ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
                                                    </DataGridTemplateColumn.Header>
                                                    <DataGridTemplateColumn.CellTemplate>
                                                        <DataTemplate>
                                                            <Border CornerRadius="6" Padding="10,2" HorizontalAlignment="Left" VerticalAlignment="Center" BorderThickness="1">
                                                                <Border.Style>
                                                                    <Style TargetType="Border">
                                                                        <Setter Property="Background" Value="Transparent"/>
                                                                        <Setter Property="BorderBrush" Value="Transparent"/>
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding IsAlarm}" Value="True">
                                                                                <Setter Property="Background" Value="{StaticResource FailTintBrush}"/>
                                                                                <Setter Property="BorderBrush" Value="{StaticResource FailBrush}"/>
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </Border.Style>
                                                                <TextBlock Text="{Binding Streak}" FontSize="14">
                                                                    <TextBlock.Style>
                                                                        <Style TargetType="TextBlock" BasedOn="{StaticResource TabularTextStyle}">
                                                                            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
                                                                            <Style.Triggers>
                                                                                <DataTrigger Binding="{Binding IsAlarm}" Value="True">
                                                                                    <Setter Property="Foreground" Value="{StaticResource FailTextBrush}"/>
                                                                                    <Setter Property="FontWeight" Value="Bold"/>
                                                                                </DataTrigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </TextBlock.Style>
                                                                </TextBlock>
                                                            </Border>
                                                        </DataTemplate>
                                                    </DataGridTemplateColumn.CellTemplate>
                                                </DataGridTemplateColumn>
                                                <DataGridTextColumn Binding="{Binding MaxStreak}" Width="1*" ElementStyle="{StaticResource TabularDataGridTextStyle}">
                                                    <DataGridTextColumn.Header>
                                                        <TextBlock Text="{DynamicResource Pmnt_ColMaxStreak}"
                                                                   TextTrimming="CharacterEllipsis"
                                                                   ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
                                                    </DataGridTextColumn.Header>
                                                </DataGridTextColumn>
                                            </DataGrid.Columns>
                                        </DataGrid>
                                    </Grid>
                                </Border>
                            </Grid>
                        </Grid>
                    </Border>

                    <!-- RIGHT COLUMN (38%): Live NG Unit Spotlight -->
                    <Grid Grid.Column="1" DataContext="{Binding Spotlight}">
                        <Border Background="{StaticResource SurfaceCardBrush}"
                                BorderBrush="{StaticResource FailBrush}"
                                BorderThickness="2"
                                CornerRadius="10"
                                Padding="12">
                        <Grid>
                            <Grid.RowDefinitions>
                                <!-- 0: Header Badge -->
                                <RowDefinition Height="Auto"/>
                                <!-- 1: Unit Metadata Hero Card -->
                                <RowDefinition Height="Auto"/>
                                <!-- 2: Dual Camera Thumbnail Grid -->
                                <RowDefinition Height="156"/>
                                <!-- 3: MES Parameter Evaluation DataGrid -->
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <!-- Spotlight Header -->
                            <Grid Grid.Row="0" Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0"
                                        Background="{StaticResource FailTintBrush}"
                                        BorderBrush="{StaticResource FailBrush}"
                                        BorderThickness="1"
                                        CornerRadius="6"
                                        Padding="10,4"
                                        HorizontalAlignment="Left">
                                    <Viewbox StretchDirection="DownOnly" HorizontalAlignment="Left">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Path Data="{StaticResource IconLightningGeometry}"
                                                  Fill="{StaticResource FailTextBrush}"
                                                  Width="14" Height="14"
                                                  Stretch="Uniform"
                                                  Margin="0,0,6,0"
                                                  VerticalAlignment="Center"/>
                                            <TextBlock Text="{DynamicResource Spot_Title}"
                                                       FontSize="15"
                                                       FontWeight="Bold"
                                                       Foreground="{StaticResource FailTextBrush}"
                                                       VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Viewbox>
                                </Border>
                                <TextBlock Grid.Column="1"
                                           Text="{Binding MesStatusText}"
                                           Style="{StaticResource TabularTextStyle}"
                                           FontSize="12"
                                           FontWeight="SemiBold"
                                           Foreground="{StaticResource TextSecondaryBrush}"
                                           HorizontalAlignment="Right"
                                           VerticalAlignment="Center"
                                           Margin="8,0,0,0"
                                           MaxWidth="210"
                                           TextTrimming="CharacterEllipsis"/>
                            </Grid>

                            <!-- Unit Metadata Hero Card -->
                            <Border Grid.Row="1"
                                    Background="{StaticResource SurfaceInputBrush}"
                                    BorderBrush="{StaticResource BorderHairlineBrush}"
                                    BorderThickness="1"
                                    CornerRadius="8"
                                    Padding="12,8"
                                    Margin="0,0,0,8">
                                <StackPanel>
                                    <Grid Margin="0,0,0,5">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Viewbox Grid.Column="0"
                                                 StretchDirection="DownOnly"
                                                 HorizontalAlignment="Left"
                                                 VerticalAlignment="Center"
                                                 Margin="0,0,8,0">
                                            <TextBlock Text="{Binding PanelName}"
                                                       Style="{StaticResource TabularTextStyle}"
                                                       FontSize="22"
                                                       FontWeight="Bold"
                                                       Foreground="{StaticResource AccentCyanBrush}"/>
                                        </Viewbox>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                            <Border Background="{StaticResource AccentTintBrush}"
                                                    BorderBrush="{StaticResource AccentBorderBrush}"
                                                    BorderThickness="1"
                                                    CornerRadius="4"
                                                    Padding="8,3"
                                                    Margin="0,0,6,0"
                                                    VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Source}"
                                                           FontSize="13"
                                                           FontWeight="Bold"
                                                           Foreground="{StaticResource AccentCyanBrush}"/>
                                            </Border>
                                            <Border Background="{StaticResource WarningTintBrush}"
                                                    BorderBrush="{StaticResource WarningBrush}"
                                                    BorderThickness="1"
                                                    CornerRadius="4"
                                                    Padding="8,3"
                                                    Margin="0,0,6,0"
                                                    VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Pmnt}"
                                                           Style="{StaticResource TabularTextStyle}"
                                                           FontSize="14"
                                                           FontWeight="Bold"
                                                           Foreground="{StaticResource WarningTextBrush}"/>
                                            </Border>
                                            <Border Background="{StaticResource FailTintBrush}"
                                                    BorderBrush="{StaticResource FailBrush}"
                                                    BorderThickness="1"
                                                    CornerRadius="4"
                                                    Padding="8,3"
                                                    Margin="0,0,6,0"
                                                    VerticalAlignment="Center"
                                                    Visibility="{Binding HasDetectedCamera, Converter={StaticResource BoolToVis}}">
                                                <TextBlock Text="{Binding DetectedCameraBadge}"
                                                           Style="{StaticResource TabularTextStyle}"
                                                           FontSize="13"
                                                           FontWeight="Bold"
                                                           Foreground="{StaticResource FailTextBrush}"/>
                                            </Border>
                                            <Border Background="{StaticResource FailTintBrush}"
                                                    BorderBrush="{StaticResource FailBrush}"
                                                    BorderThickness="1"
                                                    CornerRadius="4"
                                                    Padding="8,3"
                                                    VerticalAlignment="Center">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="{DynamicResource Spot_StreakPrefix}"
                                                               FontSize="12"
                                                               Foreground="{StaticResource FailTextBrush}"/>
                                                    <TextBlock Text="{Binding ConsecutiveNg}"
                                                               Style="{StaticResource TabularTextStyle}"
                                                               FontSize="13"
                                                               FontWeight="Bold"
                                                               Foreground="{StaticResource WarningTextBrush}"/>
                                                </StackPanel>
                                            </Border>
                                        </StackPanel>
                                    </Grid>

                                    <DockPanel Margin="0,0,0,6">
                                        <TextBlock Text="{Binding TimeFormatted}"
                                                   Style="{StaticResource TabularTextStyle}"
                                                   FontSize="13"
                                                   FontWeight="SemiBold"
                                                   Foreground="{StaticResource TextSecondaryBrush}"/>
                                        <TextBlock Text="{Binding BluName}"
                                                   FontSize="12"
                                                   Foreground="{StaticResource TextMutedBrush}"
                                                   HorizontalAlignment="Right"
                                                   TextTrimming="CharacterEllipsis"
                                                   MaxWidth="240"/>
                                    </DockPanel>

                                    <Border Background="{StaticResource FailTintBrush}"
                                            BorderBrush="{StaticResource FailBorderBrush}"
                                            BorderThickness="1"
                                            CornerRadius="6"
                                            Padding="9,6">
                                        <TextBlock Text="{Binding DefectSummary}"
                                                   FontSize="16"
                                                   FontWeight="Bold"
                                                   Foreground="{StaticResource FailTextBrush}"
                                                   TextWrapping="Wrap"/>
                                    </Border>
                                </StackPanel>
                            </Border>

                            <!-- Dual Camera Thumbnail Grid (Left Cam 1 / Right Cam 2) -->
                            <Grid Grid.Row="2" Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="1*"/>
                                    <ColumnDefinition Width="1*"/>
                                </Grid.ColumnDefinitions>

                                <!-- Left Camera Thumbnail -->
                                <Border Grid.Column="0"
                                        Background="{StaticResource SurfaceInputBrush}"
                                        BorderBrush="{StaticResource BorderHairlineBrush}"
                                        BorderThickness="1"
                                        CornerRadius="8"
                                        Padding="8"
                                        Margin="0,0,5,0">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="*"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <TextBlock Grid.Row="0"
                                                   Text="{Binding LeftCameraLabel}"
                                                   FontSize="12"
                                                   FontWeight="Bold"
                                                   Foreground="{StaticResource AccentCyanBrush}"
                                                   Margin="0,0,0,4"/>
                                        <Border Grid.Row="1" Background="{StaticResource CameraViewportBgBrush}" CornerRadius="4" ClipToBounds="True">
                                            <Image Source="{Binding LeftThumbnail}"
                                                   Stretch="Uniform"
                                                   RenderOptions.BitmapScalingMode="HighQuality"/>
                                        </Border>
                                        <TextBlock Grid.Row="2"
                                                   Text="{Binding LeftImageStatus}"
                                                   FontSize="11"
                                                   Foreground="{StaticResource TextSecondaryBrush}"
                                                   HorizontalAlignment="Center"
                                                   Margin="0,4,0,0"
                                                   TextTrimming="CharacterEllipsis"/>
                                    </Grid>
                                </Border>

                                <!-- Right Camera Thumbnail -->
                                <Border Grid.Column="1"
                                        Background="{StaticResource SurfaceInputBrush}"
                                        BorderBrush="{StaticResource BorderHairlineBrush}"
                                        BorderThickness="1"
                                        CornerRadius="8"
                                        Padding="8"
                                        Margin="4,0,0,0">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="*"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <TextBlock Grid.Row="0"
                                                   Text="{Binding RightCameraLabel}"
                                                   FontSize="12"
                                                   FontWeight="Bold"
                                                   Foreground="{StaticResource AccentCyanBrush}"
                                                   Margin="0,0,0,4"/>
                                        <Border Grid.Row="1" Background="{StaticResource CameraViewportBgBrush}" CornerRadius="4" ClipToBounds="True">
                                            <Image Source="{Binding RightThumbnail}"
                                                   Stretch="Uniform"
                                                   RenderOptions.BitmapScalingMode="HighQuality"/>
                                        </Border>
                                        <TextBlock Grid.Row="2"
                                                   Text="{Binding RightImageStatus}"
                                                   FontSize="11"
                                                   Foreground="{StaticResource TextSecondaryBrush}"
                                                   HorizontalAlignment="Center"
                                                   Margin="0,4,0,0"
                                                   TextTrimming="CharacterEllipsis"/>
                                    </Grid>
                                </Border>
                            </Grid>

                            <!-- MES Parameter Evaluation DataGrid (NG Rows Sorted First) -->
                            <DataGrid Grid.Row="3"
                                      ItemsSource="{Binding MesParameters}"
                                      FontSize="14"
                                      RowHeight="32"
                                      EnableRowVirtualization="True"
                                      EnableColumnVirtualization="True"
                                      VirtualizingPanel.IsVirtualizing="True"
                                      VirtualizingPanel.VirtualizationMode="Recycling"
                                      VirtualizingPanel.ScrollUnit="Pixel"
                                      VirtualizingPanel.CacheLength="2,2"
                                      VirtualizingPanel.CacheLengthUnit="Page">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Binding="{Binding DefectCodeGroup}" Width="0.8*" MinWidth="72" ElementStyle="{StaticResource DataGridCellTextStyle}">
                                        <DataGridTextColumn.Header>
                                            <TextBlock Text="{DynamicResource Spot_ColGroup}"
                                                       TextTrimming="CharacterEllipsis"
                                                       ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
                                        </DataGridTextColumn.Header>
                                    </DataGridTextColumn>
                                    <DataGridTextColumn Binding="{Binding ParamName}" Width="1.2*" MinWidth="95" ElementStyle="{StaticResource DataGridCellTextStyle}">
                                        <DataGridTextColumn.Header>
                                            <TextBlock Text="{DynamicResource Spot_ColParam}"
                                                       TextTrimming="CharacterEllipsis"
                                                       ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
                                        </DataGridTextColumn.Header>
                                    </DataGridTextColumn>
                                    <DataGridTextColumn Binding="{Binding ParamValue}" Width="0.8*" MinWidth="68" ElementStyle="{StaticResource TabularDataGridTextStyle}">
                                        <DataGridTextColumn.Header>
                                            <TextBlock Text="{DynamicResource Spot_ColValue}"
                                                       TextTrimming="CharacterEllipsis"
                                                       ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
                                        </DataGridTextColumn.Header>
                                    </DataGridTextColumn>
                                    <DataGridTextColumn Binding="{Binding Spec}" Width="1*" MinWidth="80" ElementStyle="{StaticResource TabularDataGridTextStyle}">
                                        <DataGridTextColumn.Header>
                                            <TextBlock Text="{DynamicResource Spot_ColSpec}"
                                                       TextTrimming="CharacterEllipsis"
                                                       ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
                                        </DataGridTextColumn.Header>
                                    </DataGridTextColumn>
                                    <DataGridTemplateColumn Width="76">
                                        <DataGridTemplateColumn.Header>
                                            <TextBlock Text="{DynamicResource Spot_ColEval}"
                                                       TextTrimming="CharacterEllipsis"
                                                       ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
                                        </DataGridTemplateColumn.Header>
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Border CornerRadius="4"
                                                        Padding="8,2"
                                                        HorizontalAlignment="Center"
                                                        BorderThickness="1">
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Setter Property="Background" Value="{StaticResource IdleTintBrush}"/>
                                                            <Setter Property="BorderBrush" Value="{StaticResource IdleBrush}"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding EvaluationStatus}" Value="Ok">
                                                                    <Setter Property="Background" Value="{StaticResource PassTintBrush}"/>
                                                                    <Setter Property="BorderBrush" Value="{StaticResource PassBorderBrush}"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding EvaluationStatus}" Value="Ng">
                                                                    <Setter Property="Background" Value="{StaticResource FailTintBrush}"/>
                                                                    <Setter Property="BorderBrush" Value="{StaticResource FailBorderBrush}"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                    <TextBlock Text="{Binding StatusText}"
                                                               FontWeight="Bold"
                                                               FontSize="12">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding EvaluationStatus}" Value="Ok">
                                                                        <Setter Property="Foreground" Value="{StaticResource PassTextBrush}"/>
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding EvaluationStatus}" Value="Ng">
                                                                        <Setter Property="Foreground" Value="{StaticResource FailTextBrush}"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                </Border>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                        </Border>

                        <!-- High-Contrast GPU Warning Border Overlay (Pulses Opacity on Render Thread when IsConsecutiveAlarm == true) -->
                        <Border CornerRadius="8"
                                BorderBrush="{StaticResource CriticalPulseBorderBrush}"
                                BorderThickness="3.5"
                                IsHitTestVisible="False">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Opacity" Value="0"/>
                                    <Style.Triggers>
                                        <MultiDataTrigger>
                                            <MultiDataTrigger.Conditions>
                                                <Condition Binding="{Binding IsConsecutiveAlarm}" Value="True"/>
                                                <Condition Binding="{Binding IsVisible, RelativeSource={RelativeSource Self}}" Value="True"/>
                                            </MultiDataTrigger.Conditions>
                                            <MultiDataTrigger.EnterActions>
                                                <BeginStoryboard x:Name="SpotlightConsecutiveAlarmPulse">
                                                    <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                                                        <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                                         From="1.0"
                                                                         To="0.25"
                                                                         Duration="0:0:0.55"/>
                                                    </Storyboard>
                                                </BeginStoryboard>
                                            </MultiDataTrigger.EnterActions>
                                            <MultiDataTrigger.ExitActions>
                                                <StopStoryboard BeginStoryboardName="SpotlightConsecutiveAlarmPulse"/>
                                            </MultiDataTrigger.ExitActions>
                                        </MultiDataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                        </Border>
                    </Grid>
                </Grid>
            </Grid>
        </Grid>
    </Grid>
</Window>
